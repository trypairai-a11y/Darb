{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/routes/keeta*.ts",
    "src/routes/americana*.ts",
    "src/routes/talabat.ts",
    "src/routes/deliveroo.ts",
    "src/queues/keeta*.ts",
    "src/queues/americana*.ts",
    "src/queues/onboardingBackwash*.ts",
    "src/queues/pullChunk*.ts",
    "src/services/americana*.ts",
    "src/services/keeta*.ts",
    "src/services/ingest/**"
  ]
}
