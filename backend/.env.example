# --- Core ---
DATABASE_URL="postgresql://darb:darb_secret@localhost:5432/darb?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Frontend origin for CORS allowlist (additional aliases live in server.ts).
FRONTEND_URL="http://localhost:3000"

# Strict tenant guard — when "true", any Prisma query without an explicit
# tenantId filter on a tenant-scoped model will throw at runtime.
TENANT_GUARD_STRICT=false

# Set to "1" automatically by Vercel; leave unset locally.
VERCEL=

# --- Third-party APIs ---
GOOGLE_MAPS_API_KEY=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
DISABLE_AGENT_SCHEDULER=true

# Keeta operations portal (used by the scraper worker).
KEETA_PORTAL_URL=""
# Symmetric key (32-byte base64) used to encrypt portal credentials at rest.
PORTAL_CRED_KEY=""

# --- Observability (Sentry) ---
SENTRY_DSN=""
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Email providers (one of) ---
RESEND_API_KEY=""
RESEND_FROM=""
SENDGRID_API_KEY=""
SENDGRID_FROM=""

# --- Twilio (SMS / WhatsApp) ---
TWILIO_ACCOUNT_SID=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# --- Photo storage (Cloudflare R2 — S3-compatible) ---
# Required for delivery-photo upload (POST /api/agent/upload-url + /api/agent/delivery-photo)
# Bucket holds private courier delivery photos; access only via short-lived presigned URLs.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Foodics POS integration (Darb 2.0) ---
# 32-byte base64 key — encrypts vendor OAuth access tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
FOODICS_TOKEN_KEY=""
# API + console hosts. Production: https://api.foodics.com/v5 + https://console.foodics.com
# Sandbox: https://api-sandbox.foodics.com/v5 + https://console-sandbox.foodics.com
FOODICS_API_BASE="https://api-sandbox.foodics.com/v5"
FOODICS_CONSOLE_BASE="https://console-sandbox.foodics.com"
# OAuth2 token endpoint (matches the console host environment).
FOODICS_TOKEN_URL="https://api-sandbox.foodics.com/oauth/token"
# Partner-app credentials from the Foodics developer console.
FOODICS_CLIENT_ID=""
FOODICS_CLIENT_SECRET=""
# Public URL of GET /api/foodics/callback as registered on the partner app.
FOODICS_REDIRECT_URI="http://localhost:3001/api/foodics/callback"
# Optional: shared HMAC secret for webhook signature verification
# (X-Foodics-Signature over the raw body). Leave empty to rely on the
# per-connection path secret only.
FOODICS_WEBHOOK_HMAC_SECRET=""

# Supervisor phone handed to the driver app for SOS "call supervisor".
DARB_SUPERVISOR_PHONE="+96550000000"

# --- Background workers ---
NOTIFICATION_WORKER_CONCURRENCY=4

# --- Feature flags / scheduler kill-switches (set to "true" to disable) ---
DISABLE_AMERICANA_WATCHER=false
DISABLE_ANOMALY_SCHEDULER=false
DISABLE_GPS_MONITOR=false
DISABLE_INSIGHTS_SCHEDULER=false
DISABLE_KEETA_SCRAPER=false
DISABLE_PERFORMANCE_TIER=false

# Direct (non-pooled) DB connection for Prisma migrations (Neon: same URL without -pooler)
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db"
