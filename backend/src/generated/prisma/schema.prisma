  @@index([entityType, entityId])
}

// 24. Ticket
model Ticket {
  id                String         @id @default(uuid())
  tenantId          String
  ticketNumber      String         @unique
  category          TicketCategory
  priority          TicketPriority @default(MEDIUM)
  title             String
  description       String
  submitterType     SubmitterType
  submitterDriverId String?
  submitterUserId   String?
  assignedToId      String?
  status            TicketStatus   @default(OPEN)
  photos            Json?
  resolution        String?
  resolvedAt        DateTime?
  slaDeadline       DateTime?
  platform          Platform?
  companyId         String?
  driverId          String?
  vehicleId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  submitterDriver Driver?  @relation("TicketSubmitterDriver", fields: [submitterDriverId], references: [id])
  submitterUser   User?    @relation("TicketSubmitterUser", fields: [submitterUserId], references: [id])
  assignedTo      User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  company         Company? @relation(fields: [companyId], references: [id])
  driver          Driver?  @relation("TicketDriver", fields: [driverId], references: [id])
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([priority])
}

// 25. LeaveRequest
model LeaveRequest {
  id           String      @id @default(uuid())
  tenantId     String
  driverId     String
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  driver     Driver @relation(fields: [driverId], references: [id])
  reviewedBy User?  @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([driverId])
}

// 26. TalabatSession
model TalabatSession {
  id                String               @id @default(uuid())
  tenantId          String
  driverId          String
  shiftId           String?
  date              DateTime
  zone              String
  vehicleType       VehicleType
  sessionCode       String
  plannedStart      DateTime
  plannedEnd        DateTime
  approvedStart     DateTime?
  approvedEnd       DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  plannedHours      Decimal              @db.Decimal(5, 2)
  approvedHours     Decimal?             @db.Decimal(5, 2)
  actualHours       Decimal?             @db.Decimal(5, 2)
  deliveries        Int                  @default(0)
  cashCollected     Decimal              @default(0) @db.Decimal(10, 3)
  tips              Decimal              @default(0) @db.Decimal(10, 3)
  distanceKm        Decimal?             @db.Decimal(10, 3)
  status            TalabatSessionStatus @default(PLANNED)
  faceVerified      Boolean              @default(false)
  equipmentVerified Boolean              @default(false)
  gpsViolation      Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  driver          Driver                  @relation(fields: [driverId], references: [id])
  shift           Shift?                  @relation(fields: [shiftId], references: [id])
  violationEvents TalabatViolationEvent[]
  deliveryItems   TalabatDelivery[]

  @@index([tenantId])
  @@index([driverId])
  @@index([date])
  @@index([zone, date])
  @@index([tenantId, date])
  @@index([tenantId, driverId, date])
  @@index([tenantId, status, date])
}

// 27. TalabatViolationEvent
model TalabatViolationEvent {
  id          String             @id @default(uuid())
  tenantId    String
  driverId    String
  sessionId   String?
  type        ViolationEventType
  description String
  metadata    Json?
  resolved    Boolean            @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime           @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  driver  Driver          @relation(fields: [driverId], references: [id])
  session TalabatSession? @relation(fields: [sessionId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, driverId, type, createdAt])
}

// 28. TalabatDelivery - individual delivery items within a session
model TalabatDelivery {
  id              String    @id @default(uuid())
  tenantId        String
  driverId        String
  sessionId       String
  date            DateTime
  platformOrderId String
  shortCode       String
  finishedAt      DateTime?
  orderType       String    @default("food")
  amount          Decimal   @default(0) @db.Decimal(10, 3)
  tip             Decimal   @default(0) @db.Decimal(10, 3)
  distanceKm      Decimal?  @db.Decimal(10, 3)
  status          String    @default("COMPLETED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  driver  Driver         @relation(fields: [driverId], references: [id])
  session TalabatSession @relation(fields: [sessionId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([sessionId])
  @@index([date])
}

// 29. KeetaDailyMetrics - mirrors the 27-column Keeta dashboard export
model KeetaDailyMetrics {
  id                   String   @id @default(uuid())
  tenantId             String
  driverId             String
  date                 DateTime
  courierPlatformId    String?
  supervisorName       String?
  vehicleType          String?
  onShift              Boolean  @default(false)
  validDay             Boolean  @default(false)
  onlineTime           Int      @default(0) // minutes
  validOnlineTime      Int      @default(0) // minutes
  peakOnlineMinutes    Int      @default(0)
  acceptedTasks        Int      @default(0)
  restaurantArrivals   Int      @default(0)
  deliveredTasks       Int      @default(0)
  largeOrdersCompleted Int      @default(0)
  cancelledTasks       Int      @default(0)
  rejectedTasks        Int      @default(0)
  rejectedByCourier    Int      @default(0)
  rejectedAuto         Int      @default(0)
  cancellationRate     Decimal? @db.Decimal(5, 4)
  completionRate       Decimal? @db.Decimal(5, 4)
  onTimeRate           Decimal? @db.Decimal(5, 4)
  largeOrderOnTimeRate Decimal? @db.Decimal(5, 4)
  avgDeliveryMinutes   Decimal? @db.Decimal(6, 2)
  over55minProportion  Decimal? @db.Decimal(5, 4)
  overdueOrders        Int      @default(0)
  severelyOverdue      Int      @default(0)
  source               String   @default("MANUAL")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, date])
  @@index([tenantId])
  @@index([driverId])
  @@index([date])
}

// 29.2. IngestRun - audit trail for scheduled ingestion (Keeta portal scraper, OCR batches, etc.)
model IngestRun {
  id         String    @id @default(cuid())
  tenantId   String
  platform   Platform
  source     String // "PORTAL_SCRAPER" | "MANUAL_UPLOAD" | "OCR_MOBILE" | "OCR_WEB"
  status     String // "SUCCESS" | "PARTIAL" | "FAILED"
  startedAt  DateTime
  finishedAt DateTime?
  rowsIn     Int?
  rowsOk     Int?
  errorLog   String?
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, platform, startedAt])
}

// 29.1.5 DeliverooDailyMetrics - per-driver Deliveroo rider "My deliveries" totals (OCR + manual)
model DeliverooDailyMetrics {
  id              String    @id @default(cuid())
  tenantId        String
  driverId        String
  shiftDate       DateTime
  codCollectedKwd Decimal   @db.Decimal(10, 3)
  tipsKwd         Decimal   @db.Decimal(10, 3)
  deliveriesCount Int
  unassignedCount Int       @default(0)
  hourlyBuckets   Json // int[9] mapped to 08,10,12,14,16,18,20,22,24
  source          String // "OCR_MOBILE" | "OCR_WEB" | "MANUAL_UPLOAD"
  status          String    @default("PARSED") // PARSED | PENDING_REVIEW | APPROVED | REJECTED
  rawImageUrl     String?
  ocrConfidence   Float?
  ocrRaw          Json?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, shiftDate])
  @@index([tenantId, shiftDate])
  @@index([tenantId, status])
  @@index([driverId, shiftDate])
}

// 29.1. TalabatDailyMetrics - per-driver daily KPIs sourced from mobile OCR / manual upload / portal API
model TalabatDailyMetrics {
  id              String    @id @default(cuid())
  tenantId        String
  driverId        String
  shiftDate       DateTime
  utr             Float?
  ordersCompleted Int?
  onlineHours     Float?
  earnings        Float?
  source          String // "OCR_MOBILE" | "OCR_WEB" | "MANUAL_UPLOAD" | "PORTAL_API"
  status          String    @default("PARSED") // "PARSED" | "PENDING_REVIEW" | "APPROVED" | "REJECTED"
  rawImageUrl     String?
  ocrConfidence   Float?
  ocrRaw          Json?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, shiftDate])
  @@index([tenantId, shiftDate])
  @@index([tenantId, status])
  @@index([driverId, shiftDate])
}

// 30. PlatformSettings - configurable targets, KPIs, and inventory per platform
model PlatformSettings {
  id                 String   @id @default(uuid())
  tenantId           String
  platform           Platform
  targets            Json // { mainTarget: {...}, subTargets: [...] }
  kpis               Json? // { weights: {...}, thresholds: {...}, gradingScale: [...] }
  shiftRules         Json? // { defaultHours: 12, maxLateMinutes: 1, ... }
  zones              Json? // ["Ardiya", "Hawally", ...]
  violationRules     Json? // penalty points, auto-detect toggles per violation type
  cashRules          Json? // deposit deadlines, overdue thresholds, collection policies
  bookingRules       Json? // shift booking windows, reminders, limits
  documentRules      Json? // required docs, expiry warning days
  notificationConfig Json? // notification preferences per event type
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform])
  @@index([tenantId])
}

// 31. PlatformInventory - total stock of equipment items per platform
model PlatformInventory {
  id        String            @id @default(uuid())
  tenantId  String
  platform  Platform
  itemType  InventoryItemType
  total     Int               @default(0)
  issued    Int               @default(0)
  available Int               @default(0)
  minStock  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform, itemType])
  @@index([tenantId])
}

// 29. AmericanaDailyOrders - daily order counts per driver per store
model AmericanaDailyOrders {
  id          String   @id @default(uuid())
  tenantId    String
  driverId    String
  month       DateTime
  chain       String? // legacy free-text, kept 3 months then drop
  chainId     String?
  empId       String?
  storeName   String? // legacy free-text, kept 3 months then drop
  storeId     String?
  company     String?
  position    String? // Car or Bike
  dailyOrders Json // { "01": 19, "02": 20, ... "28": 30 }
  totalOrders Int      @default(0)
  source      String   @default("MANUAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  driver   Driver          @relation(fields: [driverId], references: [id])
  chainRef AmericanaChain? @relation(fields: [chainId], references: [id])
  storeRef AmericanaStore? @relation(fields: [storeId], references: [id])

  @@unique([tenantId, driverId, month])
  @@index([tenantId])
  @@index([driverId])
  @@index([month])
  @@index([tenantId, chainId, month])
  @@index([tenantId, storeId, month])
}

// ─── Americana B2B fleet models ─────────────────────────────

model AmericanaChain {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  stores      AmericanaStore[]
  rates       AmericanaChainRate[]
  dailyOrders AmericanaDailyOrders[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
}

model AmericanaStore {
  id                 String   @id @default(uuid())
  tenantId           String
  chainId            String
  name               String
  area               String?
  managerName        String?
  managerPhone       String?
  backupContactName  String?
  backupContactPhone String?
  notes              String?
  active             Boolean  @default(true)
  carDailyTarget     Int?
  bikeDailyTarget    Int?
  carMonthlyTarget   Int?
  bikeMonthlyTarget  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  chain       AmericanaChain             @relation(fields: [chainId], references: [id])
  assignments AmericanaStoreAssignment[]
  dailyOrders AmericanaDailyOrders[]

  @@unique([tenantId, name])
  @@index([tenantId, chainId])
  @@index([tenantId, active])
}

model AmericanaContract {
  id              String    @id @default(uuid())
  tenantId        String
  contractRef     String
  signedDate      DateTime
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  originalFileUrl String
  ocrStatus       String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  ocrExtractedAt  DateTime?
  ocrConfidence   Float?
  ocrDraftRates   Json?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  rates  AmericanaChainRate[]

  @@unique([tenantId, contractRef])
  @@index([tenantId, effectiveFrom])
}

model AmericanaChainRate {
  id            String    @id @default(uuid())
  tenantId      String
  chainId       String
  vehicleType   String // CAR | BIKE
  ratePerOrder  Decimal   @db.Decimal(10, 3)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  contractId    String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  chain         AmericanaChain     @relation(fields: [chainId], references: [id])
  contract      AmericanaContract? @relation(fields: [contractId], references: [id])
  createdByUser User               @relation("AmericanaChainRateCreator", fields: [createdBy], references: [id])

  @@index([tenantId, chainId, vehicleType, effectiveFrom])
  @@index([createdBy])
}

/// Weekly batch assignment changes per driver. Appended whenever a driver's
/// batchNumber is updated, so the driver file can show the full batch timeline.
model DriverBatchHistory {
  id          String   @id @default(uuid())
  tenantId    String
  driverId    String
  batchNumber String?
  changedAt   DateTime @default(now())
  changedBy   String? // userId who made the change
  note        String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([driverId, changedAt])
}

model AmericanaStoreAssignment {
  id                   String    @id @default(uuid())
  tenantId             String
  driverId             String
  storeId              String
  month                DateTime // first-of-month
  startDate            DateTime
  endDate              DateTime?
  vehicleType          String // CAR | BIKE
  reasonForChange      String?
  previousAssignmentId String?
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  driver Driver         @relation(fields: [driverId], references: [id])
  store  AmericanaStore @relation(fields: [storeId], references: [id])

  @@unique([tenantId, driverId, month, startDate])
  @@index([tenantId, storeId, month])
  @@index([tenantId, driverId, month])
}

model AmericanaDailyIngestion {
  id             String    @id @default(uuid())
  tenantId       String
  source         String // EMAIL | MANUAL_UPLOAD
  emailMessageId String?
  rawFileUrl     String
  capturedAt     DateTime  @default(now())
  ingestDate     DateTime
  status         String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED | FAILED
  parsedRows     Json
  rowCount       Int
  errorLog       String?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, emailMessageId])
  @@index([tenantId, ingestDate])
  @@index([tenantId, status])
}

// 30. KpiDefinition - configurable KPI definitions with targets per platform
model KpiDefinition {
  id          String      @id @default(uuid())
  tenantId    String
  name        String // e.g. "On-Time Attendance", "Daily Orders", "Delivery Efficiency"
  description String?
  category    KpiCategory
  unit        KpiUnit
  platform    Platform? // null = common across all platforms
  target      Decimal?    @db.Decimal(10, 3)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  records KpiRecord[]

  @@unique([tenantId, name, platform])
  @@index([tenantId])
  @@index([platform])
}

// 31. KpiRecord - daily KPI values per driver
model KpiRecord {
  id              String   @id @default(uuid())
  tenantId        String
  driverId        String
  kpiDefinitionId String
  date            DateTime
  value           Decimal  @db.Decimal(10, 3)
  target          Decimal? @db.Decimal(10, 3)
  score           Decimal? @db.Decimal(5, 2) // percentage of target achieved
  source          String   @default("COMPUTED") // COMPUTED, MANUAL, IMPORT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  driver        Driver        @relation(fields: [driverId], references: [id])
  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@unique([tenantId, driverId, kpiDefinitionId, date])
  @@index([tenantId])
  @@index([driverId])
  @@index([kpiDefinitionId])
  @@index([date])
}

// 32. Notification - in-app notification for users
model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String?
  title     String
  message   String
  type      String // violation type or alert type (e.g. "GPS_OFF", "cash_overdue")
  severity  String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  sourceId  String? // ID of the violation event or alert that triggered this
  metadata  Json?
  read      Boolean   @default(false)
  readAt    DateTime?
  category  String? // "IMPORTANT", "OPS_TODO", "BENEFITS", "OTHER"
  titleAr   String?
  bodyAr    String?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// 32b. NotificationDelivery - outbound delivery audit for external channels
//      (WhatsApp, Email, SMS). Persisted by the notification queue worker so
//      failures are visible and retriable.
model NotificationDelivery {
  id             String                     @id @default(uuid())
  tenantId       String
  channel        NotificationChannel
  recipient      String
  subject        String?
  body           String
  provider       String? // twilio, sendgrid, resend, stub
  status         NotificationDeliveryStatus @default(QUEUED)
  idempotencyKey String?                    @unique
  error          String?
  attempts       Int                        @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  sourceType     String? // violation type, alert type, digest, etc.
  sourceId       String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, channel, createdAt])
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD
}

// 33. NotificationRule - maps violation types to user roles
model NotificationRule {
  id        String   @id @default(uuid())
  tenantId  String
  eventType String // ViolationEventType value or alert type
  role      UserRole
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventType, role])
  @@index([tenantId])
}

// 34. CourierOnlineSession - tracks real-time courier online status for monitor
model CourierOnlineSession {
  id           String    @id @default(uuid())
  tenantId     String
  driverId     String
  startTime    DateTime
  endTime      DateTime?
  isOnline     Boolean   @default(true)
  // Darb 2.0 dispatch availability: ONLINE | BUSY | OFFLINE. Dispatch requires
  // ONLINE; the presence sweeper forces OFFLINE when GPS goes stale.
  availability String    @default("OFFLINE")
  lastGpsAt    DateTime?
  lastGpsLat   Decimal?  @db.Decimal(10, 7)
  lastGpsLng   Decimal?  @db.Decimal(10, 7)
  area         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId, isOnline])
  @@index([tenantId, availability])
  @@index([driverId, startTime])
}

// 35. Violation - cross-platform violation with penalty/appeal workflow
model Violation {
  id                 String          @id @default(uuid())
  tenantId           String
  driverId           String?
  platform           Platform
  violationType      ViolationType
  violationStatus    ViolationStatus @default(ESTABLISHED)
  appealStatus       AppealStatus    @default(NOT_RAISED)
  firstAppealStatus  AppealStatus    @default(NOT_RAISED)
  secondAppealStatus AppealStatus    @default(NOT_RAISED)
  violationTime      DateTime
  details            String?
  metadata           Json?
  taskId             String?
  overrideReason     String?
  overriddenBy       String?
  overriddenAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  driver    Driver?   @relation(fields: [driverId], references: [id])
  penalties Penalty[]
  appeals   Appeal[]

  @@index([tenantId, violationTime])
  @@index([driverId, violationType])
  @@index([tenantId, platform, violationStatus])
}

// 36. Penalty - linked to violations via implicit m2m
model Penalty {
  id            String   @id @default(uuid())
  tenantId      String
  driverId      String
  penaltyType   String // ONLINE_TRAINING, VIOLATION_RECORD, ACCOUNT_SUSPENSION, WARNING
  penaltyStatus String   @default("EFFECTIVE") // EFFECTIVE, COMPLETED, OVERTURNED
  penaltyValue  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  driver     Driver      @relation(fields: [driverId], references: [id])
  violations Violation[]

  @@index([tenantId, driverId])
  @@index([tenantId, penaltyStatus])
}

// 37. Appeal - violation appeal with review workflow
model Appeal {
  id            String       @id @default(uuid())
  tenantId      String
  violationId   String
  appealLevel   Int          @default(1) // 1 = first appeal, 2 = second appeal
  appealStatus  AppealStatus @default(PENDING)
  channel       String? // APP, PHONE, EMAIL
  reason        String?
  rejectionNote String?
  appealedAt    DateTime     @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  violation Violation @relation(fields: [violationId], references: [id])

  @@unique([violationId, appealLevel])
  @@index([violationId])
  @@index([tenantId, appealStatus])
}

// 38. OrderEvent - order lifecycle events for flow timeline
model OrderEvent {
  id          String   @id @default(uuid())
  tenantId    String
  orderId     String
  action      String
  description String
  operator    String?
  operatorId  String?
  timestamp   DateTime
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, orderId])
  @@index([orderId, timestamp])
}

// 39. AiInsight - pre-computed AI-driven operational recommendations
model AiInsight {
  id          String   @id @default(uuid())
  tenantId    String
  category    String // REVENUE, WORKFORCE, FINANCIAL, COMPLIANCE, COACHING, EFFICIENCY
  subcategory String // e.g. "idle_positioning", "shift_gap", "cash_priority"
  context     String // page where this appears: "keeta/monitor", "dashboard", etc.
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL, OPPORTUNITY
  title       String
  description String
  actionLabel String?
  actionHref  String?
  data        Json?
  driverId    String?
  platform    String?
  score       Float    @default(0) // priority ranking
  expiresAt   DateTime
  batchId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@index([tenantId, context, expiresAt])
  @@index([tenantId, category])
  @@index([tenantId, driverId])
}

// 40. DemandHeatmap - pre-computed restaurant demand by zone/time for real-time positioning
model DemandHeatmap {
  id             String   @id @default(uuid())
  tenantId       String
  platform       String
  zone           String
  dayOfWeek      Int // 0=Sun, 6=Sat
  hourSlot       Int // 0-23
  avgOrders      Float
  topRestaurants Json // [{name, avgOrders, lat, lng}]
  confidence     Float // 0-1
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform, zone, dayOfWeek, hourSlot])
  @@index([tenantId, platform])
}

// ─── KEETA PARITY (F7–F14) ──────────────────────────────────────────────────

// Amendment B — configurable delivery areas per tenant
model DeliveryArea {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  nameAr    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

// F9 — 3-hour attendance slot per courier per day
model CourierAttendanceSlot {
  id         String   @id @default(uuid())
  tenantId   String
  driverId   String
  date       DateTime @db.Date
  slotStart  Int // 0, 3, 6, 9, 12, 15, 18, 21
  slotEnd    Int
  status     String // ON_SHIFT | NO_SHIFT | PARTIAL
  onShiftMin Int      @default(0)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, date, slotStart])
  @@index([tenantId, date])
}

// Driver-app "available shifts" — open slots drivers can claim in the platform app.
// Mirrored here so admins can see / plan capacity alongside booked shifts.
model KeetaAvailableShiftSlot {
  id          String   @id @default(cuid())
  tenantId    String
  platform    Platform @default(KEETA)
  date        DateTime
  area        String
  slotStart   String // "HH:mm"
  slotEnd     String // "HH:mm"
  capacity    Int      @default(0)
  claimed     Int      @default(0)
  vehicleType String? // BIKE, CAR — optional scope
  branchId    String?
  branchName  String?
  source      String   @default("MANUAL") // MANUAL, KEETA_SYNC, TALABAT_SYNC
  externalId  String? // id from the platform app when synced
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform, date, area, slotStart, vehicleType])
  @@index([tenantId, platform, date])
  @@index([tenantId, platform, area])
}

// F10 — per-tenant shift compliance configuration
model ShiftComplianceConfig {
  tenantId        String   @id
  underShiftHours Float    @default(10)
  evaluateCron    String   @default("0 6 * * *")
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// F11 — Partner & bank account
model Partner {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  groupId   String
  groupName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  bankAccounts    PartnerBankAccount[]
  billings        Billing[]
  incentiveRounds IncentiveTargetRound[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PartnerBankAccount {
  id          String   @id @default(uuid())
  partnerId   String
  bankName    String
  accountName String
  tailNumber  String // last 4 of IBAN
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

// F11 — Incentive engine
model IncentiveTargetRound {
  id             String   @id @default(uuid())
  tenantId       String
  partnerId      String
  period         String // "202604"
  vehicleType    String // CAR | MOTORCYCLE
  issuedAt       DateTime
  initialTarget  Int
  adjustedTarget Int?
  status         String   @default("ACTIVE") // ACTIVE | CLOSED
  operator       String   @default("Keeta OPS")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant                   @relation(fields: [tenantId], references: [id])
  partner Partner                  @relation(fields: [partnerId], references: [id])
  goals   IncentiveGoal[]
  tiers   IncentiveTier[]
  payouts CourierIncentivePayout[]

  @@unique([tenantId, partnerId, period, vehicleType])
  @@index([tenantId, period])
}

model IncentiveGoal {
  id           String @id @default(uuid())
  roundId      String
  name         String // ORDER_COMPLETION_PCT | ON_TIME_RATE
  weight       Float
  targetValue  Float
  minThreshold Float

  round IncentiveTargetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
}

model IncentiveTier {
  id      String @id @default(uuid())
  roundId String
  kind    String // EXPERIENCE | VALID_DA
  level   String // A | B | C | D
  minRate Float
  maxRate Float
  payment Int

  round IncentiveTargetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, kind])
}

model CourierIncentivePayout {
  id               String   @id @default(uuid())
  tenantId         String
  roundId          String
  driverId         String
  experienceRate   Float    @default(0)
  experienceTier   String?
  experiencePayKwd Int      @default(0)
  validDaCount     Int      @default(0)
  validDaTier      String?
  validDaPayKwd    Int      @default(0)
  totalPayKwd      Int      @default(0)
  computedAt       DateTime @default(now())

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  round  IncentiveTargetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  driver Driver               @relation(fields: [driverId], references: [id])

  @@unique([roundId, driverId])
  @@index([tenantId, driverId])
}

// F12 — Financial management
enum BillingStatus {
  PENDING_INVOICE
  AWAITING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

enum TaxInvoiceStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  WITHDRAWN
  FAILED
}

model Billing {
  id            String        @id @default(uuid())
  tenantId      String
  partnerId     String
  groupId       String
  groupName     String
  billingId     String        @unique
  billType      String // MONTHLY_SETTLEMENT | ADJUSTMENT
  period        String // "202604"
  billingDate   DateTime
  invoiceAmount Decimal       @db.Decimal(18, 3)
  payableAmount Decimal       @db.Decimal(18, 3)
  status        BillingStatus @default(PENDING_INVOICE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  partner     Partner             @relation(fields: [partnerId], references: [id])
  taxInvoice  TaxInvoice?
  withdrawals PaymentWithdrawal[]

  @@index([tenantId, period])
  @@index([tenantId, status])
}

model TaxInvoice {
  id           String           @id @default(uuid())
  tenantId     String
  billingId    String           @unique
  invoiceNo    String
  issueDate    DateTime
  sellerName   String
  totalAmount  Decimal          @db.Decimal(18, 3)
  fileUrl      String?
  status       TaxInvoiceStatus @default(DRAFT)
  rejectReason String?
  submittedAt  DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  billing Billing @relation(fields: [billingId], references: [id])

  @@index([tenantId, status])
}

model PaymentWithdrawal {
  id              String           @id @default(uuid())
  tenantId        String
  billingId       String
  groupId         String
  groupName       String
  withdrawTime    DateTime
  tailNumber      String
  amountKwd       Decimal          @db.Decimal(18, 3)
  status          WithdrawalStatus @default(PENDING)
  operationStatus String           @default("Withdrawn")
  note            String           @default("SYSTEM AUTO WITHDRAW")
  createdAt       DateTime         @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  billing Billing @relation(fields: [billingId], references: [id])

  @@index([tenantId, withdrawTime])
}

// ─── Agent Runtime (v2) ──────────────────────────────────────────────────────
// One AgentRunLog per agent invocation. AgentToolCall rows record every tool
// the agent called during that run. PendingAgentAction is the human approval
// queue for write tools that didn't meet the auto-execute threshold.

model AgentRunLog {
  id               String    @id @default(cuid())
  tenantId         String
  agentId          String // "triage" | "reconciliation" | "narrator" | "chat"
  triggerEvent     String // e.g. "violation", "appeal_submitted", "cron:15m"
  model            String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String    @default("running") // running | completed | failed
  error            String?
  actionsProposed  Int       @default(0)
  actionsApproved  Int       @default(0)
  actionsRejected  Int       @default(0)
  feedback         Json?

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  toolCalls     AgentToolCall[]
  pending       PendingAgentAction[]
  agentActions  AgentAction[]
  agentMemories AgentMemory[]

  @@index([tenantId, agentId, startedAt])
  @@index([tenantId, status])
}

model AgentToolCall {
  id         String   @id @default(cuid())
  runId      String
  toolName   String
  input      Json
  output     Json?
  error      String?
  durationMs Int      @default(0)
  approvedBy String? // userId of approving operator, if human-gated
  executedAt DateTime @default(now())

  run AgentRunLog @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([toolName, executedAt])
}

model PendingAgentAction {
  id             String    @id @default(cuid())
  tenantId       String
  runId          String
  agentId        String
  toolName       String
  input          Json
  recommendation String // "approve" | "reject" | "escalate"
  confidence     Float     @default(0)
  reasoning      String
  priorityScore  Float     @default(0)
  subjectType    String? // "appeal" | "violation" | "cash_record" | ...
  subjectId      String?
  resolvedAt     DateTime?
  resolution     String? // "approved" | "rejected"
  overrideReason String?
  resolvedBy     String?
  createdAt      DateTime  @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  run    AgentRunLog @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt, priorityScore])
  @@index([tenantId, agentId, resolvedAt])
  @@index([subjectType, subjectId])
}

// ─── Agent Spine v2 — Phase 1 (audit ledger, memory, pinned views, snapshots, analytics) ───
// CON-audit-row-shape: AgentAction is the canonical record of every fired agent action.
// Distinct from AgentRunLog (one row per LLM invocation) and PendingAgentAction
// (one row per un-resolved write proposal). This is the row the founder sees
// when answering "what did Darb do for me last week?".

model AgentAction {
  id                          String    @id @default(cuid())
  tenantId                    String
  proposer                    String    @default("Darb")
  approverId                  String
  toolName                    String
  originalProposal            Json
  modificationsBeforeApproval Json?
  outcome                     String // "success" | "failure" | "rolled_back"
  reasoning                   String    @db.Text
  agentRunId                  String?
  modelName                   String?
  promptTokens                Int       @default(0)
  completionTokens            Int       @default(0)
  latencyMs                   Int       @default(0)
  errorMessage                String?
  subjectType                 String? // "Driver" | "Shift" | "CashRecord" | ...
  subjectId                   String?
  rolledBackAt                DateTime?
  rolledBackById              String?
  rollbackReason              String?
  // Phase 4 Wave 1 — chat-origin audit trail (T-04-W1-05 Repudiation mitigation).
  // `source` defaults to "decisions" so all existing /decisions writers continue
  // to write rows tagged "decisions" with zero code change; Wave 2's chat route
  // is the first writer of `source: "chat"` (+ chatThreadId + chatMessageId).
  source                      String    @default("decisions") // "decisions" | "chat" | "briefing" | "auto"
  chatThreadId                String?
  chatMessageId               String?
  createdAt                   DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  approver     User          @relation("AgentActionApprover", fields: [approverId], references: [id])
  agentRun     AgentRunLog?  @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  chatMessages ChatMessage[] @relation("ChatMessageProposal")

  @@index([tenantId, createdAt])
  @@index([tenantId, toolName, createdAt])
  @@index([tenantId, subjectType, subjectId])
  @@index([approverId])
  @@index([tenantId, source, createdAt])
}

// Append-only per-tenant key/value notes. Latest-by-key reads use orderBy createdAt desc.
// Source values: "agent_observation" | "user_correction" | "explicit_set".

model AgentMemory {
  id         String   @id @default(cuid())
  tenantId   String
  key        String
  value      Json
  confidence Float    @default(0.5)
  source     String?
  agentRunId String?
  createdAt  DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  agentRun AgentRunLog? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([tenantId, key, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
}

// Saved generated views per user. Phase 4 (chat) consumes; Phase 1 only ships the schema.
// viewType: "table" | "chart" | "kpi_strip" | "map" | "comparison".

model PinnedView {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  title            String
  description      String?  @db.Text
  viewType         String
  spec             Json
  sortOrder        Int      @default(0)
  pinnedAt         DateTime @default(now())
  lastViewedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Phase 4 Wave 1 — refresh behaviour + chat-origin link.
  // refreshFrequency: "on_open" (re-fetch on open), "live" (poll), "static" (snapshot).
  // UI-SPEC §3.2.7 — default is "on_open".
  refreshFrequency String   @default("on_open")
  sourceThreadId   String?
  sourceMessageId  String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation("PinnedViewOwner", fields: [userId], references: [id])

  @@index([tenantId, userId, sortOrder])
  @@index([userId, pinnedAt])
}

// Daily snapshot of the composite score and contributing components.
// Backs the Driver File 90-day trend (Phase 3 consumer).
// Computed once per day by a worker (Wave 2 ships the writer); tools READ from this table.

model PerformanceSnapshot {
  id                String     @id @default(cuid())
  tenantId          String
  driverId          String
  snapshotDate      DateTime // truncated to UTC midnight
  compositeScore    Int
  attendanceScore   Int
  deliveryScore     Int
  financialScore    Int
  equipmentScore    Int
  platformScore     Int
  trend             ScoreTrend @default(STABLE)
  ordersCount       Int        @default(0)
  shiftsCount       Int        @default(0)
  violationsCount   Int        @default(0)
  cashOutstandingKd Decimal?   @db.Decimal(10, 3)
  breakdown         Json?
  computedAt        DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, snapshotDate])
  @@index([tenantId, snapshotDate])
  @@index([driverId, snapshotDate])
}

// Lightweight in-product analytics. The agent uses this to "see itself" (DEC-add-metric-events).
// Phase 1 ships the table + a recordMetricEvent helper; querying is Phase 11+.

model MetricEvent {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  event      String
  properties Json?
  sessionId  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation("MetricEventActor", fields: [userId], references: [id])

  @@index([tenantId, event, createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

// ─── Phase 4 Wave 1 — Chat surface + scheduled briefings ───
// REQ-chat-global-access + REQ-chat-generated-dashboards + REQ-chat-scheduled-jobs.
// Tenant-scoped + user-scoped (defense in depth — see RESEARCH §"Per-User
// Searchable Chat History"). 90-day retention via archivedAt; chatHistoryService
// runs the cleanup. Standing-rule type kept on ScheduledBriefing for forward
// compatibility — Phase 12 (REQ-data-agent-rule) wires the firing engine.

model ChatThread {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  title         String    @default("New chat")
  pinned        Boolean   @default(false)
  source        String    @default("user") // "user" | "briefing"
  briefingId    String?
  lastMessageAt DateTime  @default(now())
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  user     User               @relation("ChatThreadOwner", fields: [userId], references: [id])
  briefing ScheduledBriefing? @relation(fields: [briefingId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([tenantId, userId, lastMessageAt(sort: Desc)])
  @@index([userId, pinned, lastMessageAt(sort: Desc)])
  @@index([tenantId, archivedAt])
}

model ChatMessage {
  id               String   @id @default(cuid())
  tenantId         String
  threadId         String
  role             String // "user" | "assistant" | "system"
  content          String   @db.Text
  views            Json     @default("[]")
  toolCalls        Json     @default("[]")
  proposalId       String?
  state            String   @default("complete") // queued|tool_running|streaming|complete|error|cancelled
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int      @default(0)
  modelName        String?
  errorMessage     String?
  createdAt        DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  thread   ChatThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  proposal AgentAction? @relation("ChatMessageProposal", fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([tenantId, createdAt])
}

model ScheduledBriefing {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  name       String
  cron       String
  prompt     String    @db.Text
  recipients Json      @default("[]")
  channels   Json      @default("[\"in_chat\"]")
  type       String    @default("briefing") // "briefing" | "standing_rule_v3"
  active     Boolean   @default(true)
  nextFireAt DateTime?
  lastFireAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  creator User         @relation("ScheduledBriefingCreator", fields: [userId], references: [id])
  threads ChatThread[]

  @@index([tenantId, active, nextFireAt])
  @@index([userId, active])
}

// ─── Darb 2.0 — B2B Delivery Fulfillment (Slice A1) ─────────────────────────

enum DeliveryOrderStatus {
  CREATED
  REJECTED
  DISPATCHING
  NO_DRIVER
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

enum DeliveryOrderSource {
  FOODICS
  VENDOR_PORTAL
  SUPERVISOR
  PARTNER_API
}

enum PaymentMethod {
  COD
  PREPAID
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum WalletOwnerType {
  DRIVER_CASH
  VENDOR_PAYABLE
  PLATFORM_REVENUE
  PLATFORM_CLEARING
}

enum WalletTxType {
  COD_SETTLEMENT
  PREPAID_SETTLEMENT
  REMITTANCE
  ADJUSTMENT
  VENDOR_PAYOUT
  REFUND
  TIP
  FLEET_PAYOUT
}

enum IncidentType {
  SOS
  ACCIDENT
  VEHICLE_BREAKDOWN
  CUSTOMER_ISSUE
  OTHER
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum FoodicsConnStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// D1. Vendor - restaurant / merchant that sends us delivery orders
model Vendor {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  nameAr          String?
  code            String // short code used in order numbers, e.g. "BRGB"
  phone           String?
  requiresCarOnly Boolean  @default(false)
  isPaused        Boolean  @default(false) // paused vendors get orders REJECTED (VENDOR_PAUSED)
  // PRD §11 credit line: NULL = no cap. When the vendor's outstanding debt
  // (negative VENDOR_PAYABLE balance) reaches the cap, new orders are
  // REJECTED (VENDOR_CREDIT_CAP) until settled.
  creditCapKwd    Decimal? @db.Decimal(10, 3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  branches          VendorBranch[]
  users             User[]
  orders            DeliveryOrder[]
  foodicsConnection FoodicsConnection?
  apiKeys           ApiKey[]
  statements        VendorStatement[]
  refunds           Refund[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// D2. VendorBranch - physical pickup location; zoneId resolved point-in-polygon
//     at save time and re-resolved on zone edits.
model VendorBranch {
  id              String   @id @default(uuid())
  tenantId        String
  vendorId        String
  name            String
  nameAr          String?
  address         String?
  phone           String?
  lat             Decimal? @db.Decimal(10, 7)
  lng             Decimal? @db.Decimal(10, 7)
  zoneId          String?
  foodicsBranchId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  vendor      Vendor          @relation(fields: [vendorId], references: [id])
  zone        DeliveryZone?   @relation(fields: [zoneId], references: [id])
  orders      DeliveryOrder[]
  // Revision 1 (#9) — portal users scoped to this branch.
  portalUsers User[]          @relation("BranchPortalUser")

  @@unique([tenantId, foodicsBranchId])
  @@index([tenantId])
  @@index([vendorId])
}

// D3. DeliveryZone - GeoJSON polygon ([lng,lat] ring) with a precomputed bbox
//     prefilter [minLng, minLat, maxLng, maxLat] and centroid.
model DeliveryZone {
  id          String   @id @default(uuid())
  tenantId    String
  code        String // e.g. "SALMIYA"
  name        String
  nameAr      String?
  polygon     Json // GeoJSON Polygon geometry, coordinates in [lng, lat] order
  bbox        Json // [minLng, minLat, maxLng, maxLat]
  centroidLat Decimal? @db.Decimal(10, 7)
  centroidLng Decimal? @db.Decimal(10, 7)
  // Revision 1 (#8) — the polygon editor has always sent a colour; without a
  // column to hold it every zone edit silently discarded it and the list dot
  // fell back to Darb green, which read as "zone edits do not save".
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  branches         VendorBranch[]
  originSurcharges ZoneSurcharge[] @relation("SurchargeOrigin")
  destSurcharges   ZoneSurcharge[] @relation("SurchargeDest")
  pickupOrders     DeliveryOrder[] @relation("OrderPickupZone")
  dropoffOrders    DeliveryOrder[] @relation("OrderDropoffZone")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// D4. ZoneSurcharge - cross-zone delivery surcharge. Absence of a row for an
//     (origin, dest) pair means the pair is unserviceable.
model ZoneSurcharge {
  id           String   @id @default(uuid())
  tenantId     String
  originZoneId String
  destZoneId   String
  surchargeKwd Decimal  @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  originZone DeliveryZone @relation("SurchargeOrigin", fields: [originZoneId], references: [id])
  destZone   DeliveryZone @relation("SurchargeDest", fields: [destZoneId], references: [id])

  @@unique([tenantId, originZoneId, destZoneId])
  @@index([tenantId])
}

// D5. FulfillmentSettings - one row per tenant; dispatch + pricing knobs
model FulfillmentSettings {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  intraZoneFeeKwd        Decimal  @default(1.250) @db.Decimal(10, 3)
  driverCashCeilingKwd   Decimal  @default(100.000) @db.Decimal(10, 3)
  offerWindowSec         Int      @default(15)
  maxOfferRounds         Int      @default(8)
  searchRadiusKm         Float    @default(8)
  gpsStaleAfterSec       Int      @default(180)
  // PRD §8 dispatch: progressive radius widening across offer rounds.
  radiusWidenAfterRounds Int      @default(3)
  radiusWidenFactor      Float    @default(1.5)
  maxSearchRadiusKm      Float    @default(15)
  // PRD §8 dispatch: auto-batching (one pickup, multiple drops only).
  batchingEnabled        Boolean  @default(true)
  batchMaxDropKm         Float    @default(1.5)
  batchMaxOrders         Int      @default(2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// D6. DeliveryOrder - core Darb 2.0 order (Foodics webhook, vendor portal, or
//     supervisor manual). Coarse status FSM; granular milestones live in
//     OrderEvent rows keyed by this id.
model DeliveryOrder {
  id              String              @id @default(uuid())
  tenantId        String
  orderNumber     String // "DRB-{vendorCode}-{seq}"
  source          DeliveryOrderSource
  foodicsOrderId  String?
  vendorId        String
  branchId        String
  status          DeliveryOrderStatus @default(CREATED)
  paymentMethod   PaymentMethod       @default(COD)
  orderTotalKwd   Decimal             @db.Decimal(10, 3)
  deliveryFeeKwd  Decimal?            @db.Decimal(10, 3)
  customerName    String?
  customerPhone   String?
  dropoffAddress  String?
  dropoffLat      Decimal?            @db.Decimal(10, 7)
  dropoffLng      Decimal?            @db.Decimal(10, 7)
  pickupZoneId    String?
  dropoffZoneId   String?
  driverId        String?
  offerRound      Int                 @default(0)
  requiresCarOnly Boolean             @default(false)
  rejectionReason String? // OUT_OF_ZONE_DROPOFF | UNSERVICEABLE_PAIR | NO_COORDINATES | BRANCH_UNZONED | VENDOR_PAUSED | VENDOR_CREDIT_CAP
  cancelReason    String?
  failureReason   String?
  proofPhotoUrl   String?
  podPin          String? // 4-digit PIN generated at creation
  codCollectedKwd Decimal?            @db.Decimal(10, 3)
  slaDeadline     DateTime?
  // PRD §6 scheduling: NULL = immediate. Scheduled orders persist as CREATED
  // and are advanced to DISPATCHING by the cron sweep near the due time.
  scheduledAt     DateTime?
  // PRD §6 return-to-merchant: set on the FAILED→RETURNED transition.
  returnedAt      DateTime?
  // PRD §8 auto-batching: set at accept time when the driver won a batched
  // offer (one pickup, multiple drops). NULL for single-order trips.
  batchId         String?
  // PRD §11 tips: customer tip via the tracking link; driver keeps 100%.
  tipKwd          Decimal?            @db.Decimal(10, 3)
  // PRD §12 tracking link credential: 128-bit random, the only auth for the
  // public /api/track surface. NULL only on pre-PRD historical rows.
  trackingToken   String?             @unique
  // PRD §2 partner intake idempotency: the merchant system's own order id.
  externalRef     String?
  // PRD §11 refunds: set when a full-order refund is PROCESSED.
  refundedAt      DateTime?
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  vendor      Vendor          @relation(fields: [vendorId], references: [id])
  branch      VendorBranch    @relation(fields: [branchId], references: [id])
  driver      Driver?         @relation(fields: [driverId], references: [id])
  pickupZone  DeliveryZone?   @relation("OrderPickupZone", fields: [pickupZoneId], references: [id])
  dropoffZone DeliveryZone?   @relation("OrderDropoffZone", fields: [dropoffZoneId], references: [id])
  offers      DispatchOffer[]
  incidents   Incident[]
  rating      OrderRating?
  refund      Refund?

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, foodicsOrderId])
  @@unique([tenantId, vendorId, externalRef])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, vendorId, createdAt])
  @@index([driverId, status])
  @@index([tenantId, slaDeadline])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, batchId])
}

// D7. DispatchOffer - one serialized 15s offer to one driver per round
model DispatchOffer {
  id          String      @id @default(uuid())
  tenantId    String
  orderId     String
  driverId    String
  round       Int
  distanceKm  Float?
  // PRD §8 auto-batching: offers created together for one driver share a
  // batchId; accept/decline/expire act on the whole batch.
  batchId     String?
  status      OfferStatus @default(OFFERED)
  offeredAt   DateTime    @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  DeliveryOrder @relation(fields: [orderId], references: [id])
  driver Driver        @relation(fields: [driverId], references: [id])

  @@unique([orderId, driverId, round])
  @@index([tenantId, status])
  @@index([driverId, status])
  @@index([batchId])
}

// D8. WalletAccount - one ledger account per owner; balanceKwd is a cache,
//     the WalletEntry rows are the source of truth.
model WalletAccount {
  id         String          @id @default(uuid())
  tenantId   String
  ownerType  WalletOwnerType
  ownerKey   String // "DRIVER:{id}" | "VENDOR:{id}" | "PLATFORM_REVENUE" | "PLATFORM_CLEARING"
  balanceKwd Decimal         @default(0) @db.Decimal(10, 3)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  entries WalletEntry[]

  @@unique([tenantId, ownerKey])
  @@index([tenantId, ownerType])
}

// D9. WalletTransaction - append-only double-entry transaction header.
//     No update/delete code paths; corrections are compensating transactions.
model WalletTransaction {
  id             String       @id @default(uuid())
  tenantId       String
  type           WalletTxType
  idempotencyKey String       @unique // "cod-settle:{orderId}", "remit:{id}", ...
  orderId        String?
  remittanceId   String?
  memo           String?
  createdById    String?
  createdAt      DateTime     @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  entries WalletEntry[]

  @@index([tenantId, createdAt])
  @@index([orderId])
}

// D10. WalletEntry - balanced debit/credit legs of a WalletTransaction
model WalletEntry {
  id                String   @id @default(uuid())
  tenantId          String
  transactionId     String
  accountId         String
  direction         String // DEBIT | CREDIT
  amountKwd         Decimal  @db.Decimal(10, 3) // always > 0
  runningBalanceKwd Decimal  @db.Decimal(10, 3)
  createdAt         DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  transaction WalletTransaction @relation(fields: [transactionId], references: [id])
  account     WalletAccount     @relation(fields: [accountId], references: [id])

  @@index([tenantId])
  @@index([transactionId])
  @@index([accountId, createdAt])
}

// D11. Remittance - driver hands collected cash to the hub
model Remittance {
  id           String        @id @default(uuid())
  tenantId     String
  driverId     String
  amountKwd    Decimal       @db.Decimal(10, 3)
  method       DepositMethod
  receiptUrl   String?
  receivedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId, createdAt])
  @@index([driverId, createdAt])
}

// D12. WalletReconciliationRun - nightly invariant checks over the ledger
model WalletReconciliationRun {
  id        String   @id @default(uuid())
  tenantId  String
  runDate   DateTime
  status    String // OK | MISMATCH
  checks    Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, runDate])
  @@index([tenantId, status])
}

// D13. Incident - SOS + operational incidents raised from the driver app
model Incident {
  id               String         @id @default(uuid())
  tenantId         String
  type             IncidentType
  status           IncidentStatus @default(OPEN)
  severity         String         @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  driverId         String
  orderId          String?
  lat              Decimal?       @db.Decimal(10, 7)
  lng              Decimal?       @db.Decimal(10, 7)
  description      String?
  reportedVia      String? // APP, PHONE
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNote   String?
  metadata         Json? // photo R2 keys etc.
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  driver Driver         @relation(fields: [driverId], references: [id])
  order  DeliveryOrder? @relation(fields: [orderId], references: [id])

  @@index([tenantId, status])
  @@index([driverId, createdAt])
}

// D14. FoodicsConnection - per-vendor Foodics OAuth connection
model FoodicsConnection {
  id             String            @id @default(uuid())
  tenantId       String
  vendorId       String            @unique
  accessTokenEnc String? // AES-256-GCM encrypted (env FOODICS_TOKEN_KEY)
  orderTagId     String? // only orders tagged with this tag are ingested
  webhookSecret  String
  status         FoodicsConnStatus @default(PENDING)
  lastEventAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
}

// D15. WebhookEvent - raw inbound webhook idempotency log. Intentionally NOT
//      tenant-scoped: rows are written before the tenant is resolved.
model WebhookEvent {
  id          String             @id @default(uuid())
  provider    String // "foodics"
  eventKey    String             @unique // idempotency key derived from the payload
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())

  @@index([status, createdAt])
}

// ── Darb 2.0 PRD build (DARB2-PRD-001 v3.0) ────────────────────────────────

// D16. ApiKey - partner order-intake credential (PRD §2: orders arrive
//      ready-made via API). The raw key is shown once at creation; only its
//      sha256 hash is stored. Auth attaches {tenantId, vendorId} to the
//      request, so a key is always scoped to exactly one merchant.
model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  vendorId    String
  name        String // operator label, e.g. "Royal POS integration"
  keyHash     String    @unique // sha256(rawKey)
  keyPrefix   String // first 8 chars of the raw key, for support lookups
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([tenantId, vendorId])
}

// D17. OrderRating - customer 1-5 star rating from the tracking link
//      (PRD §12). One per order; stars <= 2 feed the violation ladder
//      (LOW_CUSTOMER_RATING).
model OrderRating {
  id        String   @id @default(uuid())
  tenantId  String
  orderId   String   @unique
  driverId  String
  stars     Int // 1..5, validated at the route layer
  comment   String?
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  DeliveryOrder @relation(fields: [orderId], references: [id])
  driver Driver        @relation(fields: [driverId], references: [id])

  @@index([tenantId, driverId, createdAt])
}

// D18. VendorStatement - monthly netting statement per merchant (PRD §11:
//      "at month-end the net decides who pays whom"). Idempotent on
//      (tenantId, vendorId, periodStart). closingBalance > 0 = Darb owes the
//      vendor; payout posts a VENDOR_PAYOUT wallet transaction.
model VendorStatement {
  id                String   @id @default(uuid())
  tenantId          String
  vendorId          String
  periodStart       DateTime // first day of month, 00:00 UTC
  periodEnd         DateTime // exclusive
  openingBalanceKwd Decimal  @db.Decimal(10, 3)
  codNetKwd         Decimal  @db.Decimal(10, 3) // Σ COD (total - fee) credited
  prepaidFeesKwd    Decimal  @db.Decimal(10, 3) // Σ prepaid fees debited
  refundsKwd        Decimal  @default(0) @db.Decimal(10, 3)
  closingBalanceKwd Decimal  @db.Decimal(10, 3)
  status            String   @default("FINAL") // FINAL | PAID
  payoutTxId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([tenantId, vendorId, periodStart])
  @@index([tenantId, periodStart])
}

// D19. Refund - full-order refund (PRD §11: merchant approves, Darb
//      processes). One per order. Processing posts a compensating REFUND
//      wallet transaction; driver cash is never touched.
model Refund {
  id            String   @id @default(uuid())
  tenantId      String
  orderId       String   @unique
  vendorId      String
  amountKwd     Decimal  @db.Decimal(10, 3) // orderTotalKwd snapshot
  reason        String
  status        String   @default("REQUESTED") // REQUESTED | PROCESSED | REJECTED
  requestedById String?
  processedById String?
  walletTxId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  DeliveryOrder @relation(fields: [orderId], references: [id])
  vendor Vendor        @relation(fields: [vendorId], references: [id])

  @@index([tenantId, status])
}

// D20. FleetPartner - subcontracted delivery company (PRD §9: Darb employs
//      no drivers; fleets are onboarded, governed and paid a flat per-order
//      rate). Deliberately separate from the legacy Company model, which is
//      welded to the aggregator platforms.
model FleetPartner {
  id                   String   @id @default(uuid())
  tenantId             String
  name                 String
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  flatFeePerOrderKwd   Decimal  @default(1.100) @db.Decimal(10, 3)
  minOnlineHoursPerDay Float?
  minDriversOnline     Json? // { "<zoneId>": n } contractual commitment
  disciplineStatus     String   @default("OK") // OK | WARNED | THROTTLED | SUSPENDED | REMOVED
  disciplineNote       String?
  isActive             Boolean  @default(true)
  // Revision 1 (#15/#27/#28) — Sidra, Marina and Nakheel are the same owner.
  // One login reaches the whole group and reporting can be combined.
  ownerGroupId         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  ownerGroup OwnerGroup?            @relation(fields: [ownerGroupId], references: [id])
  drivers    Driver[]
  users      User[]
  statements FleetPayoutStatement[]

  @@index([tenantId, isActive])
  @@index([tenantId, ownerGroupId])
}

// D21. FleetPayoutStatement - monthly fleet payout (PRD §11: delivered
//      orders x flat fee, fleets paid monthly). feePerOrderKwd is snapshotted
//      so a rate change never rewrites history. Payment posts a FLEET_PAYOUT
//      wallet transaction.
model FleetPayoutStatement {
  id              String   @id @default(uuid())
  tenantId        String
  fleetPartnerId  String
  periodStart     DateTime
  periodEnd       DateTime // exclusive
  deliveredOrders Int
  feePerOrderKwd  Decimal  @db.Decimal(10, 3)
  totalKwd        Decimal  @db.Decimal(10, 3)
  status          String   @default("FINAL") // FINAL | PAID
  payoutTxId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  fleet  FleetPartner @relation(fields: [fleetPartnerId], references: [id])

  @@unique([tenantId, fleetPartnerId, periodStart])
  @@index([tenantId, periodStart])
}
