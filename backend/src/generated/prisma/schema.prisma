// 2. Company
model Company {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  platform         Platform
  licenseCount     Int      @default(0)
  isActive         Boolean  @default(true)
  // Revision 1 (#21) — a company row is either a delivery/courier company we
  // subcontract to, or a merchant-side account. The Companies table mixed both
  // with no way to tell them apart.
  kind             String   @default("FLEET") // FLEET | VENDOR
  // Revision 1 (#15/#27) — commonly-owned companies share an owner entity.
  ownerGroupId     String?
  // Revision 1 (#20) — the internal Darb staff member who owns this account.
  accountManagerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  ownerGroup          OwnerGroup?           @relation(fields: [ownerGroupId], references: [id])
  accountManager      User?                 @relation("CompanyAccountManager", fields: [accountManagerId], references: [id])
  drivers             Driver[]
  vehicles            Vehicle[]
  recruitmentPipeline RecruitmentPipeline[]
  tickets             Ticket[]

  @@index([tenantId])
  @@index([tenantId, ownerGroupId])
}

// 2b. OwnerGroup — Revision 1 (#15/#27/#28). Several delivery companies are
//     owned and run by the same people (e.g. Sidra + Marina + Nakheel). The
//     group is the unit of login (one account reaches every company in it) and
//     the unit of combined/averaged reporting.
model OwnerGroup {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  contactName  String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  fleets    FleetPartner[]
  companies Company[]
  users     User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// 3. User
model User {
  id              String    @id @default(uuid())
  tenantId        String
  email           String    @unique
  phone           String?
  passwordHash    String
  name            String
  role            UserRole  @default(VIEWER)
  // Phase 2 Wave 1 — super-admin flag. Read on every request from the DB
  // (NOT from JWT) by the requireSuperAdmin middleware to prevent stale-flag
  // attacks (T-02-06).
  isSuperAdmin    Boolean   @default(false)
  jobGrade        String? // e.g. "Team Leader", "Supervisor", "Senior Supervisor", "Area Manager"
  // Darb 2.0 — set for role=VENDOR users; scopes the vendor portal (vendorId
  // comes from the JWT, never from the client).
  vendorId        String?
  // Darb 2.0 PRD — set for role=FLEET users; scopes the fleet portal
  // (fleetPartnerId comes from the JWT, never from the client).
  fleetPartnerId  String?
  // Revision 1 (#15/#27) — a FLEET login scoped to an owner group rather than a
  // single partner. When set, the user may switch between every fleet in the
  // group; fleetPartnerId is then the default/last-used partner, not a fence.
  ownerGroupId    String?
  // Revision 1 (#9) — vendor portal users are created per branch with a role.
  // branchId is null for vendor-wide roles (OWNER, FINANCE).
  branchId        String?
  vendorRole      String? // OWNER | FINANCE | ORDER_TRACKING
  // Revision 10 (#6) — per-user tab access inside the merchant portal, as a
  // JSON array of tab keys (ORDERS | WALLET | GROW | SUPPORT | TEAM |
  // SETTINGS). NULL means "inherit whatever this vendorRole opens by default",
  // which is what every existing shop login does, so this ships with no
  // backfill. An explicit [] means no tabs at all.
  vendorTabs      Json?
  // Revision 13 (#6) — the fleet portal's own team, the mirror of the merchant
  // portal's. fleetRole is OWNER | OPERATIONS | FINANCE and NULL reads as
  // OWNER, so every login that existed before this keeps opening everything it
  // already could. fleetTabs REPLACES the role's default tab list (null =
  // inherit). fleetPartnerIds narrows an owner-group login to a subset of the
  // group's companies (null = the whole group), which is what the vendor
  // portal's branchId does for a shop.
  fleetRole       String?
  fleetTabs       Json?
  fleetPartnerIds Json?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id])
  vendor                  Vendor?                 @relation(fields: [vendorId], references: [id])
  fleetPartner            FleetPartner?           @relation(fields: [fleetPartnerId], references: [id])
  ownerGroup              OwnerGroup?             @relation(fields: [ownerGroupId], references: [id])
  branch                  VendorBranch?           @relation("BranchPortalUser", fields: [branchId], references: [id])
  managedCompanies        Company[]               @relation("CompanyAccountManager")
  supervisedDrivers       Driver[]                @relation("DriverSupervisor")
  issuedCommands          DeviceCommand[]         @relation("CommandIssuer")
  acknowledgedAlerts      Alert[]                 @relation("AlertAcknowledger")
  reviewedLeaves          LeaveRequest[]          @relation("LeaveReviewer")
  assignedTickets         Ticket[]                @relation("TicketAssignee")
  submittedTickets        Ticket[]                @relation("TicketSubmitterUser")
  notifications           Notification[]
  createdAmericanaRates   AmericanaChainRate[]    @relation("AmericanaChainRateCreator")
  approvedAgentActions    AgentAction[]           @relation("AgentActionApprover")
  pinnedViews             PinnedView[]            @relation("PinnedViewOwner")
  metricEvents            MetricEvent[]           @relation("MetricEventActor")
  // Phase 4 Wave 1 — chat ownership + briefing authorship.
  chatThreads             ChatThread[]            @relation("ChatThreadOwner")
  scheduledBriefings      ScheduledBriefing[]     @relation("ScheduledBriefingCreator")
  // Revision 4 (#12) — self-service password on invite, per-surface access,
  // and the merchants an account manager owns.
  invites                 UserInvite[]
  surfacePermissions      UserSurfacePermission[]
  managedVendors          AccountManagerVendor[]
  // Revision 12 — fleet portal request desk authorship.
  uploadedFleetDocuments  FleetDocument[]         @relation("FleetDocumentUploader")
  reviewedFleetDocuments  FleetDocument[]         @relation("FleetDocumentReviewer")
  requestedFleetChanges   FleetChangeRequest[]    @relation("FleetRequestRequester")
  reviewedFleetChanges    FleetChangeRequest[]    @relation("FleetRequestReviewer")
  acknowledgedFleetIssues FleetIssue[]            @relation("FleetIssueAcknowledger")
  resolvedFleetIssues     FleetIssue[]            @relation("FleetIssueResolver")
  uploadedPayoutInvoices  FleetPayoutInvoice[]    @relation("FleetPayoutInvoiceUploader")

  @@index([tenantId])
}

// 4. Driver
model Driver {
  id                 String       @id @default(uuid())
  tenantId           String
  companyId          String
  name               String
  phone              String
  // Revision 1 (#14) — the Darb-issued driver identifier ("DRB-0001"). Finance
  // searches remittances by this, not by name. platformDriverId below is the
  // inherited Keeta/Talabat id and is not unique to Darb.
  driverCode         String?
  platform           Platform
  platformDriverId   String?
  utr                String?
  vehicleType        VehicleType
  zone               String?
  batchNumber        String?
  status             DriverStatus @default(ACTIVE)
  hireDate           DateTime
  photoUrl           String?
  supervisorId       String?
  // Phase 9 Wave 0 — bilingual outbound preferences + push token.
  preferredLanguage  Language     @default(AUTO)
  outboundOptIn      Boolean      @default(true)
  smsOptOut          Boolean      @default(false)
  expoPushToken      String? // ExponentPushToken[...] — rotated per Pitfall 4
  monthlySalary      Float?
  monthlyOffDaysUsed Int          @default(0)
  offDaysResetMonth  String? // format: "YYYY-MM", reset tracker
  performanceTier    String? // GOLD | SILVER | BRONZE | WATCHLIST (R9)
  tierComputedAt     DateTime?
  // PRD §9 fleet discipline ladder: while set and in the future, the driver
  // sorts after all non-throttled candidates in dispatch.
  throttledUntil     DateTime?
  // PRD §9 fleet governance: which delivery company employs this driver.
  fleetPartnerId     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Document expiry dates and statuses
  healthCertExpiry       DateTime?
  healthCertStatus       String? // VALID, EXPIRING, EXPIRED, MISSING
  workPermitExpiry       DateTime?
  workPermitStatus       String?
  foodHandlingCertExpiry DateTime?
  foodHandlingCertStatus String?
  vehicleRegExpiry       DateTime?
  vehicleRegStatus       String?
  vehicleInsuranceExpiry DateTime?
  vehicleInsuranceStatus String?
  drivingLicenseExpiry   DateTime?
  drivingLicenseStatus   String?
  civilIdExpiry          DateTime?
  civilIdStatus          String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id])
  supervisor   User?         @relation("DriverSupervisor", fields: [supervisorId], references: [id])
  fleetPartner FleetPartner? @relation(fields: [fleetPartnerId], references: [id])

  inventory                 DriverInventory[]
  shifts                    Shift[]
  attendanceRecords         AttendanceRecord[]
  orderLogs                 OrderLog[]
  cashRecords               CashRecord[]
  cashTransactions          CashTransaction[]
  pendingDuesLedgers        PendingDuesLedger[]
  vehicleInspections        VehicleInspection[]
  maintenanceRecords        MaintenanceRecord[]
  aiScores                  AiScore[]
  alerts                    Alert[]
  capturedOrders            CapturedOrder[]
  locationLogs              LocationLog[]
  appUsageLogs              AppUsageLog[]
  device                    Device?
  assignedVehicle           Vehicle?                   @relation("AssignedDriver")
  vehicleAssignments        VehicleDriverAssignment[]
  leaveRequests             LeaveRequest[]
  restrictions              DriverRestriction[]
  tickets                   Ticket[]                   @relation("TicketDriver")
  submittedTickets          Ticket[]                   @relation("TicketSubmitterDriver")
  talabatSessions           TalabatSession[]
  talabatViolationEvents    TalabatViolationEvent[]
  talabatDailyMetrics       TalabatDailyMetrics[]
  deliverooDailyMetrics     DeliverooDailyMetrics[]
  keetaDailyMetrics         KeetaDailyMetrics[]
  americanaDailyOrders      AmericanaDailyOrders[]
  talabatDeliveries         TalabatDelivery[]
  kpiRecords                KpiRecord[]
  courierOnlineSessions     CourierOnlineSession[]
  violations                Violation[]
  penalties                 Penalty[]
  aiInsights                AiInsight[]
  courierAttendanceSlots    CourierAttendanceSlot[]
  courierIncentivePayouts   CourierIncentivePayout[]
  americanaStoreAssignments AmericanaStoreAssignment[]
  sims                      Sim[]
  performanceSnapshots      PerformanceSnapshot[]
  batchHistory              DriverBatchHistory[]
  // Darb 2.0 — delivery fulfillment (Slice A1)
  deliveryOrders            DeliveryOrder[]
  dispatchOffers            DispatchOffer[]
  remittances               Remittance[]
  incidents                 Incident[]
  orderRatings              OrderRating[]
  // Revision 12 — fleet portal request desk.
  fleetDocuments            FleetDocument[]
  fleetChangeRequests       FleetChangeRequest[]
  fleetIssues               FleetIssue[]
  // Client request 2026-08-01 — the driver app's notification feed.
  notifications             Notification[]

  @@unique([tenantId, driverCode])
  @@index([tenantId])
  @@index([companyId])
  @@index([platform])
  @@index([tenantId, platform, status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
}

// 5. DriverRestriction
model DriverRestriction {
  id          String          @id @default(uuid())
  tenantId    String
  driverId    String
  type        RestrictionType
  startDate   DateTime
  endDate     DateTime? // null = permanent
  reason      String?
  processedAt DateTime? // when attendance records were auto-generated
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([startDate])
}

// 6. DriverInventory
model DriverInventory {
  id                  String             @id @default(uuid())
  driverId            String
  // Slug, not the InventoryItemType enum: a custom platform item has to be
  // issuable to a driver or creating one is only half a feature.
  itemType            String
  issued              Boolean            @default(false)
  quantity            Int                @default(0)
  issuedDate          DateTime?
  returnedDate        DateTime?
  // Driver-reported condition (set from the mobile agent app).
  condition           EquipmentCondition @default(OK)
  conditionNote       String?
  conditionReportedAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

// 6. RecruitmentPipeline
model RecruitmentPipeline {
  id                String           @id @default(uuid())
  tenantId          String
  candidateName     String
  phone             String
  stage             RecruitmentStage @default(AGENCY_REFERRAL)
  agency            String?
  expectedDate      DateTime?
  notes             String?
  assignedCompanyId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  assignedCompany Company? @relation(fields: [assignedCompanyId], references: [id])

  @@index([tenantId])
}

// 7. Vehicle
model Vehicle {
  id                 String        @id @default(uuid())
  tenantId           String
  companyId          String
  plateNumber        String        @unique
  vehicleType        VehicleType
  make               String
  model              String
  year               Int
  color              String?
  chassisNumber      String?
  mileage            Int           @default(0)
  fuelType           String        @default("Petrol")
  ownerCompany       String?
  driverIqama        String?
  status             VehicleStatus @default(ACTIVE)
  assignedDriverId   String?       @unique
  insuranceExpiry    DateTime
  registrationExpiry DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  company        Company @relation(fields: [companyId], references: [id])
  assignedDriver Driver? @relation("AssignedDriver", fields: [assignedDriverId], references: [id])

  inspections        VehicleInspection[]
  maintenanceRecords MaintenanceRecord[]       @relation("VehicleMaintenance")
  spareMaintenance   MaintenanceRecord[]       @relation("SpareVehicle")
  alerts             Alert[]
  tickets            Ticket[]
  driverAssignments  VehicleDriverAssignment[]

  @@index([tenantId])
  @@index([companyId])
}

// Many-to-many: a vehicle can be shared across multiple drivers.
model VehicleDriverAssignment {
  id           String    @id @default(uuid())
  tenantId     String
  vehicleId    String
  driverId     String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  active       Boolean   @default(true)
  note         String?
  createdAt    DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, driverId])
  @@index([tenantId])
  @@index([vehicleId, active])
  @@index([driverId, active])
}

// 8. Shift
model Shift {
  id                  String      @id @default(uuid())
  tenantId            String
  driverId            String
  date                DateTime
  platform            Platform
  zone                String?
  scheduledStart      DateTime
  scheduledEnd        DateTime
  actualStart         DateTime? // Darb app clock-in (selfie-gated)
  actualEnd           DateTime? // Darb app clock-out
  platformClockIn     DateTime? // Synced from delivery platform (Keeta online session, Talabat XLSX, etc.)
  platformClockOut    DateTime?
  varianceMinutes     Int? // |actualStart - platformClockIn| — diagnostic
  status              ShiftStatus @default(BOOKED)
  isValid             Boolean?
  plannedHoursMinutes Int?
  actualHoursMinutes  Int?
  selfieUrl           String?
  selfieLocation      Json?
  clockInMethod       String?
  clockOutMethod      String?
  shiftScreenshotUrl  String?
  deliveryArea        String? // Amendment B: Hawally, Avenues, Salmiya, etc.
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  driver            Driver             @relation(fields: [driverId], references: [id])
  attendanceRecords AttendanceRecord[]
  orderLogs         OrderLog[]
  talabatSessions   TalabatSession[]

  @@index([tenantId])
  @@index([driverId])
  @@index([date])
  @@index([tenantId, date])
  @@index([tenantId, driverId, date])
  @@index([tenantId, deliveryArea, date])
}

// 9. AttendanceRecord
model AttendanceRecord {
  id               String           @id @default(uuid())
  tenantId         String
  driverId         String
  shiftId          String?
  date             DateTime
  status           AttendanceStatus
  lateMinutes      Int              @default(0)
  source           String           @default("manual")
  // Dual clock tracking — Darb app vs delivery platform
  darbClockIn      DateTime?
  darbClockOut     DateTime?
  platformClockIn  DateTime?
  platformClockOut DateTime?
  varianceMinutes  Int? // |darbClockIn - platformClockIn|
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
  shift  Shift? @relation(fields: [shiftId], references: [id])

  @@unique([tenantId, driverId, date], name: "tenantId_driverId_date")
  @@index([tenantId])
  @@index([driverId])
  @@index([date])
}

// 10. OrderLog
model OrderLog {
  id             String      @id @default(uuid())
  tenantId       String
  driverId       String
  shiftId        String?
  date           DateTime
  platform       Platform
  orderCount     Int
  distanceKm     Decimal?    @db.Decimal(10, 3)
  cashCollected  Decimal?    @db.Decimal(10, 3)
  tips           Decimal?    @db.Decimal(10, 3)
  totalAmount    Decimal?    @db.Decimal(10, 3)
  orderNumber    String?
  paymentSource  String?
  restaurantName String?
  arrivalTime    DateTime?
  screenshotUrl  String?
  source         OrderSource @default(MANUAL)
  rawData        Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
  shift  Shift? @relation(fields: [shiftId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([date])
  @@index([tenantId, date])
  @@index([tenantId, platform, date])
}

// 11. CashRecord
model CashRecord {
  id                String         @id @default(uuid())
  tenantId          String
  driverId          String
  date              DateTime
  salesAmount       Decimal        @db.Decimal(10, 3)
  collectionAmount  Decimal        @default(0) @db.Decimal(10, 3)
  depositMethod     DepositMethod?
  depositReceiptUrl String?
  pendingDues       Decimal        @db.Decimal(10, 3)
  status            CashStatus     @default(PENDING)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([date])
  @@index([tenantId, status, date])
  @@index([tenantId, driverId, date])
}

// 11b. CashTransaction
model CashTransaction {
  id             String              @id @default(uuid())
  tenantId       String
  driverId       String
  date           DateTime
  type           CashTransactionType
  amount         Decimal             @db.Decimal(10, 3)
  orderNumber    String?
  description    String?
  runningBalance Decimal             @db.Decimal(10, 3)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([date])
}

// 12. PendingDuesLedger
model PendingDuesLedger {
  id               String       @id @default(uuid())
  tenantId         String
  driverId         String
  month            DateTime
  openingBalance   Decimal      @db.Decimal(10, 3)
  totalSales       Decimal      @db.Decimal(10, 3)
  totalCollection  Decimal      @db.Decimal(10, 3)
  cashDeposits     Decimal      @db.Decimal(10, 3)
  bankTransfers    Decimal      @db.Decimal(10, 3)
  incentives       Decimal      @db.Decimal(10, 3)
  adjustments      Decimal      @db.Decimal(10, 3)
  closingBalance   Decimal      @db.Decimal(10, 3)
  dailySales       Json
  dailyCollections Json
  status           LedgerStatus @default(OPEN)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, month], name: "tenantId_driverId_month")
  @@index([tenantId])
  @@index([driverId])
  @@index([month])
}

// 13. VehicleInspection
model VehicleInspection {
  id               String           @id @default(uuid())
  tenantId         String
  vehicleId        String
  driverId         String
  date             DateTime
  status           InspectionStatus
  photos           Json?
  notes            String?
  deductionApplied Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
}

// 14. MaintenanceRecord
model MaintenanceRecord {
  id             String              @id @default(uuid())
  tenantId       String
  vehicleId      String
  driverId       String?
  category       MaintenanceCategory
  type           String
  cost           Decimal             @db.Decimal(10, 3)
  vendor         String?
  receiptUrl     String?
  spareVehicleId String?
  status         MaintenanceStatus   @default(REQUESTED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  vehicle      Vehicle  @relation("VehicleMaintenance", fields: [vehicleId], references: [id])
  driver       Driver?  @relation(fields: [driverId], references: [id])
  spareVehicle Vehicle? @relation("SpareVehicle", fields: [spareVehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
}

// 15. Device
model Device {
  id            String       @id @default(uuid())
  tenantId      String
  driverId      String?      @unique
  imei          String       @unique
  model         String
  osVersion     String
  agentVersion  String?
  lastSeen      DateTime?
  batteryLevel  Int?
  isOnline      Boolean      @default(false)
  status        DeviceStatus @default(ACTIVE)
  lastLatitude  Decimal?     @db.Decimal(10, 7)
  lastLongitude Decimal?     @db.Decimal(10, 7)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  driver         Driver?         @relation(fields: [driverId], references: [id])
  capturedOrders CapturedOrder[]
  locationLogs   LocationLog[]
  appUsageLogs   AppUsageLog[]
  commands       DeviceCommand[]
  sims           Sim[]

  @@index([driverId])
}

model Sim {
  id          String    @id @default(uuid())
  tenantId    String
  phoneNumber String
  carrier     String?
  status      SimStatus @default(ACTIVE)
  driverId    String?
  deviceId    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@unique([tenantId, phoneNumber])
  @@index([tenantId, status])
  @@index([driverId])
  @@index([deviceId])
}

// 16. CapturedOrder
model CapturedOrder {
  id               String   @id @default(uuid())
  deviceId         String
  driverId         String
  platform         Platform
  notificationText String
  parsedData       Json?
  capturedAt       DateTime

  device Device @relation(fields: [deviceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([deviceId])
  @@index([driverId])
}

// 17. LocationLog
model LocationLog {
  id         String   @id @default(uuid())
  deviceId   String
  driverId   String
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracy   Decimal  @db.Decimal(10, 2)
  speed      Decimal? @db.Decimal(10, 2)
  capturedAt DateTime

  device Device @relation(fields: [deviceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, capturedAt])
  @@index([deviceId])
}

// 18. AppUsageLog
model AppUsageLog {
  id              String   @id @default(uuid())
  deviceId        String
  driverId        String
  appPackage      String
  eventType       String
  durationSeconds Int?
  capturedAt      DateTime

  device Device @relation(fields: [deviceId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([deviceId])
  @@index([driverId])
}

// 19. DeviceCommand
model DeviceCommand {
  id             String            @id @default(uuid())
  deviceId       String
  command        DeviceCommandType
  payload        Json?
  status         CommandStatus     @default(PENDING)
  issuedById     String
  issuedAt       DateTime          @default(now())
  acknowledgedAt DateTime?

  device   Device @relation(fields: [deviceId], references: [id])
  issuedBy User   @relation("CommandIssuer", fields: [issuedById], references: [id])

  @@index([deviceId])
}

// 20. AiScore
model AiScore {
  id              String     @id @default(uuid())
  tenantId        String
  driverId        String
  date            DateTime
  compositeScore  Int
  attendanceScore Int
  deliveryScore   Int
  financialScore  Int
  equipmentScore  Int
  platformScore   Int
  breakdown       Json?
  trend           ScoreTrend @default(STABLE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, date], name: "tenantId_driverId_date_score")
  @@index([tenantId])
  @@index([driverId])
  @@index([date])
  @@index([tenantId, date])
}

// 21. Alert
model Alert {
  id               String        @id @default(uuid())
  tenantId         String
  type             String
  severity         AlertSeverity
  title            String
  message          String
  driverId         String?
  vehicleId        String?
  data             Json?
  status           AlertStatus   @default(ACTIVE)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  driver         Driver?  @relation(fields: [driverId], references: [id])
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id])
  acknowledgedBy User?    @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, driverId, type, createdAt])
}

// 22. AiDigest
model AiDigest {
  id          String   @id @default(uuid())
  tenantId    String
  date        DateTime
  content     Json
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId])
}

// 23. AuditLog
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}

// 24. Ticket
model Ticket {
  id                String         @id @default(uuid())
  tenantId          String
  ticketNumber      String         @unique
  category          TicketCategory
  priority          TicketPriority @default(MEDIUM)
  title             String
  description       String
  submitterType     SubmitterType
  submitterDriverId String?
  submitterUserId   String?
  assignedToId      String?
  status            TicketStatus   @default(OPEN)
  photos            Json?
  resolution        String?
  resolvedAt        DateTime?
  slaDeadline       DateTime?
  platform          Platform?
  companyId         String?
  driverId          String?
  vehicleId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  submitterDriver Driver?  @relation("TicketSubmitterDriver", fields: [submitterDriverId], references: [id])
  submitterUser   User?    @relation("TicketSubmitterUser", fields: [submitterUserId], references: [id])
  assignedTo      User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  company         Company? @relation(fields: [companyId], references: [id])
  driver          Driver?  @relation("TicketDriver", fields: [driverId], references: [id])
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([priority])
}

// 25. LeaveRequest
model LeaveRequest {
  id           String      @id @default(uuid())
  tenantId     String
  driverId     String
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  driver     Driver @relation(fields: [driverId], references: [id])
  reviewedBy User?  @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([driverId])
}

// 26. TalabatSession
model TalabatSession {
  id                String               @id @default(uuid())
  tenantId          String
  driverId          String
  shiftId           String?
  date              DateTime
  zone              String
  vehicleType       VehicleType
  sessionCode       String
  plannedStart      DateTime
  plannedEnd        DateTime
  approvedStart     DateTime?
  approvedEnd       DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  plannedHours      Decimal              @db.Decimal(5, 2)
  approvedHours     Decimal?             @db.Decimal(5, 2)
  actualHours       Decimal?             @db.Decimal(5, 2)
  deliveries        Int                  @default(0)
  cashCollected     Decimal              @default(0) @db.Decimal(10, 3)
  tips              Decimal              @default(0) @db.Decimal(10, 3)
  distanceKm        Decimal?             @db.Decimal(10, 3)
  status            TalabatSessionStatus @default(PLANNED)
  faceVerified      Boolean              @default(false)
  equipmentVerified Boolean              @default(false)
  gpsViolation      Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  driver          Driver                  @relation(fields: [driverId], references: [id])
  shift           Shift?                  @relation(fields: [shiftId], references: [id])
  violationEvents TalabatViolationEvent[]
  deliveryItems   TalabatDelivery[]

  @@index([tenantId])
  @@index([driverId])
  @@index([date])
  @@index([zone, date])
  @@index([tenantId, date])
  @@index([tenantId, driverId, date])
  @@index([tenantId, status, date])
}

// 27. TalabatViolationEvent
model TalabatViolationEvent {
  id          String             @id @default(uuid())
  tenantId    String
  driverId    String
  sessionId   String?
  type        ViolationEventType
  description String
  metadata    Json?
  resolved    Boolean            @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime           @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  driver  Driver          @relation(fields: [driverId], references: [id])
  session TalabatSession? @relation(fields: [sessionId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, driverId, type, createdAt])
}

// 28. TalabatDelivery - individual delivery items within a session
model TalabatDelivery {
  id              String    @id @default(uuid())
  tenantId        String
  driverId        String
  sessionId       String
  date            DateTime
  platformOrderId String
  shortCode       String
  finishedAt      DateTime?
  orderType       String    @default("food")
  amount          Decimal   @default(0) @db.Decimal(10, 3)
  tip             Decimal   @default(0) @db.Decimal(10, 3)
  distanceKm      Decimal?  @db.Decimal(10, 3)
  status          String    @default("COMPLETED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  driver  Driver         @relation(fields: [driverId], references: [id])
  session TalabatSession @relation(fields: [sessionId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([sessionId])
  @@index([date])
}

// 29. KeetaDailyMetrics - mirrors the 27-column Keeta dashboard export
model KeetaDailyMetrics {
  id                   String   @id @default(uuid())
  tenantId             String
  driverId             String
  date                 DateTime
  courierPlatformId    String?
  supervisorName       String?
  vehicleType          String?
  onShift              Boolean  @default(false)
  validDay             Boolean  @default(false)
  onlineTime           Int      @default(0) // minutes
  validOnlineTime      Int      @default(0) // minutes
  peakOnlineMinutes    Int      @default(0)
  acceptedTasks        Int      @default(0)
  restaurantArrivals   Int      @default(0)
  deliveredTasks       Int      @default(0)
  largeOrdersCompleted Int      @default(0)
  cancelledTasks       Int      @default(0)
  rejectedTasks        Int      @default(0)
  rejectedByCourier    Int      @default(0)
  rejectedAuto         Int      @default(0)
  cancellationRate     Decimal? @db.Decimal(5, 4)
  completionRate       Decimal? @db.Decimal(5, 4)
  onTimeRate           Decimal? @db.Decimal(5, 4)
  largeOrderOnTimeRate Decimal? @db.Decimal(5, 4)
  avgDeliveryMinutes   Decimal? @db.Decimal(6, 2)
  over55minProportion  Decimal? @db.Decimal(5, 4)
  overdueOrders        Int      @default(0)
  severelyOverdue      Int      @default(0)
  source               String   @default("MANUAL")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, date])
  @@index([tenantId])
  @@index([driverId])
  @@index([date])
}

// 29.2. IngestRun - audit trail for scheduled ingestion (Keeta portal scraper, OCR batches, etc.)
model IngestRun {
  id         String    @id @default(cuid())
  tenantId   String
  platform   Platform
  source     String // "PORTAL_SCRAPER" | "MANUAL_UPLOAD" | "OCR_MOBILE" | "OCR_WEB"
  status     String // "SUCCESS" | "PARTIAL" | "FAILED"
  startedAt  DateTime
  finishedAt DateTime?
  rowsIn     Int?
  rowsOk     Int?
  errorLog   String?
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, platform, startedAt])
}

// 29.1.5 DeliverooDailyMetrics - per-driver Deliveroo rider "My deliveries" totals (OCR + manual)
model DeliverooDailyMetrics {
  id              String    @id @default(cuid())
  tenantId        String
  driverId        String
  shiftDate       DateTime
  codCollectedKwd Decimal   @db.Decimal(10, 3)
  tipsKwd         Decimal   @db.Decimal(10, 3)
  deliveriesCount Int
  unassignedCount Int       @default(0)
  hourlyBuckets   Json // int[9] mapped to 08,10,12,14,16,18,20,22,24
  source          String // "OCR_MOBILE" | "OCR_WEB" | "MANUAL_UPLOAD"
  status          String    @default("PARSED") // PARSED | PENDING_REVIEW | APPROVED | REJECTED
  rawImageUrl     String?
  ocrConfidence   Float?
  ocrRaw          Json?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, shiftDate])
  @@index([tenantId, shiftDate])
  @@index([tenantId, status])
  @@index([driverId, shiftDate])
}

// 29.1. TalabatDailyMetrics - per-driver daily KPIs sourced from mobile OCR / manual upload / portal API
model TalabatDailyMetrics {
  id              String    @id @default(cuid())
  tenantId        String
  driverId        String
  shiftDate       DateTime
  utr             Float?
  ordersCompleted Int?
  onlineHours     Float?
  earnings        Float?
  source          String // "OCR_MOBILE" | "OCR_WEB" | "MANUAL_UPLOAD" | "PORTAL_API"
  status          String    @default("PARSED") // "PARSED" | "PENDING_REVIEW" | "APPROVED" | "REJECTED"
  rawImageUrl     String?
  ocrConfidence   Float?
  ocrRaw          Json?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, shiftDate])
  @@index([tenantId, shiftDate])
  @@index([tenantId, status])
  @@index([driverId, shiftDate])
}

// 30. PlatformSettings - configurable targets, KPIs, and inventory per platform
model PlatformSettings {
  id                 String   @id @default(uuid())
  tenantId           String
  platform           Platform
  targets            Json // { mainTarget: {...}, subTargets: [...] }
  kpis               Json? // { weights: {...}, thresholds: {...}, gradingScale: [...] }
  shiftRules         Json? // { defaultHours: 12, maxLateMinutes: 1, ... }
  zones              Json? // ["Ardiya", "Hawally", ...]
  violationRules     Json? // penalty points, auto-detect toggles per violation type
  cashRules          Json? // deposit deadlines, overdue thresholds, collection policies
  bookingRules       Json? // shift booking windows, reminders, limits
  documentRules      Json? // required docs, expiry warning days
  notificationConfig Json? // notification preferences per event type
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform])
  @@index([tenantId])
}

// 31. PlatformInventory - total stock of equipment items per platform
model PlatformInventory {
  id        String   @id @default(uuid())
  tenantId  String
  platform  Platform
  // Was the InventoryItemType enum. Ops can now create their own item types
  // from /assets, and a new kind of kit must not need a migration, so the
  // column is a slug (UPPER_SNAKE) with `label` carrying the display name.
  // The enum still exists in the database; nothing reads it any more.
  itemType  String
  label     String?
  total     Int      @default(0)
  issued    Int      @default(0)
  available Int      @default(0)
  minStock  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform, itemType])
  @@index([tenantId])
}

// 29. AmericanaDailyOrders - daily order counts per driver per store
model AmericanaDailyOrders {
  id          String   @id @default(uuid())
  tenantId    String
  driverId    String
  month       DateTime
  chain       String? // legacy free-text, kept 3 months then drop
  chainId     String?
  empId       String?
  storeName   String? // legacy free-text, kept 3 months then drop
  storeId     String?
  company     String?
  position    String? // Car or Bike
  dailyOrders Json // { "01": 19, "02": 20, ... "28": 30 }
  totalOrders Int      @default(0)
  source      String   @default("MANUAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  driver   Driver          @relation(fields: [driverId], references: [id])
  chainRef AmericanaChain? @relation(fields: [chainId], references: [id])
  storeRef AmericanaStore? @relation(fields: [storeId], references: [id])

  @@unique([tenantId, driverId, month])
  @@index([tenantId])
  @@index([driverId])
  @@index([month])
  @@index([tenantId, chainId, month])
  @@index([tenantId, storeId, month])
}

// ─── Americana B2B fleet models ─────────────────────────────

model AmericanaChain {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  stores      AmericanaStore[]
  rates       AmericanaChainRate[]
  dailyOrders AmericanaDailyOrders[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
}

model AmericanaStore {
  id                 String   @id @default(uuid())
  tenantId           String
  chainId            String
  name               String
  area               String?
  managerName        String?
  managerPhone       String?
  backupContactName  String?
  backupContactPhone String?
  notes              String?
  active             Boolean  @default(true)
  carDailyTarget     Int?
  bikeDailyTarget    Int?
  carMonthlyTarget   Int?
  bikeMonthlyTarget  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  chain       AmericanaChain             @relation(fields: [chainId], references: [id])
  assignments AmericanaStoreAssignment[]
  dailyOrders AmericanaDailyOrders[]

  @@unique([tenantId, name])
  @@index([tenantId, chainId])
  @@index([tenantId, active])
}

model AmericanaContract {
  id              String    @id @default(uuid())
  tenantId        String
  contractRef     String
  signedDate      DateTime
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  originalFileUrl String
  ocrStatus       String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  ocrExtractedAt  DateTime?
  ocrConfidence   Float?
  ocrDraftRates   Json?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  rates  AmericanaChainRate[]

  @@unique([tenantId, contractRef])
  @@index([tenantId, effectiveFrom])
}

model AmericanaChainRate {
  id            String    @id @default(uuid())
  tenantId      String
  chainId       String
  vehicleType   String // CAR | BIKE
  ratePerOrder  Decimal   @db.Decimal(10, 3)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  contractId    String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  chain         AmericanaChain     @relation(fields: [chainId], references: [id])
  contract      AmericanaContract? @relation(fields: [contractId], references: [id])
  createdByUser User               @relation("AmericanaChainRateCreator", fields: [createdBy], references: [id])

  @@index([tenantId, chainId, vehicleType, effectiveFrom])
  @@index([createdBy])
}

/// Weekly batch assignment changes per driver. Appended whenever a driver's
/// batchNumber is updated, so the driver file can show the full batch timeline.
model DriverBatchHistory {
  id          String   @id @default(uuid())
  tenantId    String
  driverId    String
  batchNumber String?
  changedAt   DateTime @default(now())
  changedBy   String? // userId who made the change
  note        String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([driverId, changedAt])
}

model AmericanaStoreAssignment {
  id                   String    @id @default(uuid())
  tenantId             String
  driverId             String
  storeId              String
  month                DateTime // first-of-month
  startDate            DateTime
  endDate              DateTime?
  vehicleType          String // CAR | BIKE
  reasonForChange      String?
  previousAssignmentId String?
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  driver Driver         @relation(fields: [driverId], references: [id])
  store  AmericanaStore @relation(fields: [storeId], references: [id])

  @@unique([tenantId, driverId, month, startDate])
  @@index([tenantId, storeId, month])
  @@index([tenantId, driverId, month])
}

model AmericanaDailyIngestion {
  id             String    @id @default(uuid())
  tenantId       String
  source         String // EMAIL | MANUAL_UPLOAD
  emailMessageId String?
  rawFileUrl     String
  capturedAt     DateTime  @default(now())
  ingestDate     DateTime
  status         String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED | FAILED
  parsedRows     Json
  rowCount       Int
  errorLog       String?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, emailMessageId])
  @@index([tenantId, ingestDate])
  @@index([tenantId, status])
}

// 30. KpiDefinition - configurable KPI definitions with targets per platform
model KpiDefinition {
  id          String      @id @default(uuid())
  tenantId    String
  name        String // e.g. "On-Time Attendance", "Daily Orders", "Delivery Efficiency"
  description String?
  category    KpiCategory
  unit        KpiUnit
  platform    Platform? // null = common across all platforms
  target      Decimal?    @db.Decimal(10, 3)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  records KpiRecord[]

  @@unique([tenantId, name, platform])
  @@index([tenantId])
  @@index([platform])
}

// 31. KpiRecord - daily KPI values per driver
model KpiRecord {
  id              String   @id @default(uuid())
  tenantId        String
  driverId        String
  kpiDefinitionId String
  date            DateTime
  value           Decimal  @db.Decimal(10, 3)
  target          Decimal? @db.Decimal(10, 3)
  score           Decimal? @db.Decimal(5, 2) // percentage of target achieved
  source          String   @default("COMPUTED") // COMPUTED, MANUAL, IMPORT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  driver        Driver        @relation(fields: [driverId], references: [id])
  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@unique([tenantId, driverId, kpiDefinitionId, date])
  @@index([tenantId])
  @@index([driverId])
  @@index([kpiDefinitionId])
  @@index([date])
}

// 32. Notification - in-app notification for users
model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String?
  /// Client request 2026-08-01: the driver app needed somewhere to read its
  /// notifications, and a driver is not a User row, so userId could never
  /// address one. Exactly one of userId / driverId is set in practice; both
  /// null is a tenant-wide notice, which is what the staff feed already relied
  /// on, so nothing needed backfilling.
  driverId  String?
  title     String
  message   String
  type      String // violation type or alert type (e.g. "GPS_OFF", "cash_overdue")
  severity  String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  sourceId  String? // ID of the violation event or alert that triggered this
  metadata  Json?
  read      Boolean   @default(false)
  readAt    DateTime?
  category  String? // "IMPORTANT", "OPS_TODO", "BENEFITS", "OTHER"
  titleAr   String?
  bodyAr    String?
  createdAt DateTime  @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([read])
  @@index([driverId, createdAt])
  @@index([createdAt])
}

// 32b. NotificationDelivery - outbound delivery audit for external channels
//      (WhatsApp, Email, SMS). Persisted by the notification queue worker so
//      failures are visible and retriable.
model NotificationDelivery {
  id             String                     @id @default(uuid())
  tenantId       String
  channel        NotificationChannel
  recipient      String
  subject        String?
  body           String
  provider       String? // twilio, sendgrid, resend, stub
  status         NotificationDeliveryStatus @default(QUEUED)
  idempotencyKey String?                    @unique
  error          String?
  attempts       Int                        @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  sourceType     String? // violation type, alert type, digest, etc.
  sourceId       String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, channel, createdAt])
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD
}

// 33. NotificationRule - maps violation types to user roles
model NotificationRule {
  id        String   @id @default(uuid())
  tenantId  String
  eventType String // ViolationEventType value or alert type
  role      UserRole
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventType, role])
  @@index([tenantId])
}

// 34. CourierOnlineSession - tracks real-time courier online status for monitor
model CourierOnlineSession {
  id           String    @id @default(uuid())
  tenantId     String
  driverId     String
  startTime    DateTime
  endTime      DateTime?
  isOnline     Boolean   @default(true)
  // Darb 2.0 dispatch availability: ONLINE | BUSY | OFFLINE. Dispatch requires
  // ONLINE; the presence sweeper forces OFFLINE when GPS goes stale.
  availability String    @default("OFFLINE")
  lastGpsAt    DateTime?
  lastGpsLat   Decimal?  @db.Decimal(10, 7)
  lastGpsLng   Decimal?  @db.Decimal(10, 7)
  area         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId, isOnline])
  @@index([tenantId, availability])
  @@index([driverId, startTime])
}

// 35. Violation - cross-platform violation with penalty/appeal workflow
model Violation {
  id                 String          @id @default(uuid())
  tenantId           String
  driverId           String?
  platform           Platform
  violationType      ViolationType
  violationStatus    ViolationStatus @default(ESTABLISHED)
  appealStatus       AppealStatus    @default(NOT_RAISED)
  firstAppealStatus  AppealStatus    @default(NOT_RAISED)
  secondAppealStatus AppealStatus    @default(NOT_RAISED)
  violationTime      DateTime
  details            String?
  metadata           Json?
  taskId             String?
  overrideReason     String?
  overriddenBy       String?
  overriddenAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  driver    Driver?   @relation(fields: [driverId], references: [id])
  penalties Penalty[]
  appeals   Appeal[]

  @@index([tenantId, violationTime])
  @@index([driverId, violationType])
  @@index([tenantId, platform, violationStatus])
}

// 36. Penalty - linked to violations via implicit m2m
model Penalty {
  id            String   @id @default(uuid())
  tenantId      String
  driverId      String
  penaltyType   String // ONLINE_TRAINING, VIOLATION_RECORD, ACCOUNT_SUSPENSION, WARNING
  penaltyStatus String   @default("EFFECTIVE") // EFFECTIVE, COMPLETED, OVERTURNED
  penaltyValue  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  driver     Driver      @relation(fields: [driverId], references: [id])
  violations Violation[]

  @@index([tenantId, driverId])
  @@index([tenantId, penaltyStatus])
}

// 37. Appeal - violation appeal with review workflow
model Appeal {
  id            String       @id @default(uuid())
  tenantId      String
  violationId   String
  appealLevel   Int          @default(1) // 1 = first appeal, 2 = second appeal
  appealStatus  AppealStatus @default(PENDING)
  channel       String? // APP, PHONE, EMAIL
  reason        String?
  rejectionNote String?
  appealedAt    DateTime     @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  violation Violation @relation(fields: [violationId], references: [id])

  @@unique([violationId, appealLevel])
  @@index([violationId])
  @@index([tenantId, appealStatus])
}

// 38. OrderEvent - order lifecycle events for flow timeline
model OrderEvent {
  id          String   @id @default(uuid())
  tenantId    String
  orderId     String
  action      String
  description String
  operator    String?
  operatorId  String?
  timestamp   DateTime
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, orderId])
  @@index([orderId, timestamp])
}

// 39. AiInsight - pre-computed AI-driven operational recommendations
model AiInsight {
  id          String   @id @default(uuid())
  tenantId    String
  category    String // REVENUE, WORKFORCE, FINANCIAL, COMPLIANCE, COACHING, EFFICIENCY
  subcategory String // e.g. "idle_positioning", "shift_gap", "cash_priority"
  context     String // page where this appears: "keeta/monitor", "dashboard", etc.
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL, OPPORTUNITY
  title       String
  description String
  actionLabel String?
  actionHref  String?
  data        Json?
  driverId    String?
  platform    String?
  score       Float    @default(0) // priority ranking
  expiresAt   DateTime
  batchId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@index([tenantId, context, expiresAt])
  @@index([tenantId, category])
  @@index([tenantId, driverId])
}

// 40. DemandHeatmap - pre-computed restaurant demand by zone/time for real-time positioning
model DemandHeatmap {
  id             String   @id @default(uuid())
  tenantId       String
  platform       String
  zone           String
  dayOfWeek      Int // 0=Sun, 6=Sat
  hourSlot       Int // 0-23
  avgOrders      Float
  topRestaurants Json // [{name, avgOrders, lat, lng}]
  confidence     Float // 0-1
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform, zone, dayOfWeek, hourSlot])
  @@index([tenantId, platform])
}

// ─── KEETA PARITY (F7–F14) ──────────────────────────────────────────────────

// Amendment B — configurable delivery areas per tenant
model DeliveryArea {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  nameAr    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

// F9 — 3-hour attendance slot per courier per day
model CourierAttendanceSlot {
  id         String   @id @default(uuid())
  tenantId   String
  driverId   String
  date       DateTime @db.Date
  slotStart  Int // 0, 3, 6, 9, 12, 15, 18, 21
  slotEnd    Int
  status     String // ON_SHIFT | NO_SHIFT | PARTIAL
  onShiftMin Int      @default(0)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, date, slotStart])
  @@index([tenantId, date])
}

// Driver-app "available shifts" — open slots drivers can claim in the platform app.
// Mirrored here so admins can see / plan capacity alongside booked shifts.
model KeetaAvailableShiftSlot {
  id          String   @id @default(cuid())
  tenantId    String
  platform    Platform @default(KEETA)
  date        DateTime
  area        String
  slotStart   String // "HH:mm"
  slotEnd     String // "HH:mm"
  capacity    Int      @default(0)
  claimed     Int      @default(0)
  vehicleType String? // BIKE, CAR — optional scope
  branchId    String?
  branchName  String?
  source      String   @default("MANUAL") // MANUAL, KEETA_SYNC, TALABAT_SYNC
  externalId  String? // id from the platform app when synced
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform, date, area, slotStart, vehicleType])
  @@index([tenantId, platform, date])
  @@index([tenantId, platform, area])
}

// F10 — per-tenant shift compliance configuration
model ShiftComplianceConfig {
  tenantId        String   @id
  underShiftHours Float    @default(10)
  evaluateCron    String   @default("0 6 * * *")
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// F11 — Partner & bank account
model Partner {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  groupId   String
  groupName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  bankAccounts    PartnerBankAccount[]
  billings        Billing[]
  incentiveRounds IncentiveTargetRound[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PartnerBankAccount {
  id          String   @id @default(uuid())
  partnerId   String
  bankName    String
  accountName String
  tailNumber  String // last 4 of IBAN
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

// F11 — Incentive engine
model IncentiveTargetRound {
  id             String   @id @default(uuid())
  tenantId       String
  partnerId      String
  period         String // "202604"
  vehicleType    String // CAR | MOTORCYCLE
  issuedAt       DateTime
  initialTarget  Int
  adjustedTarget Int?
  status         String   @default("ACTIVE") // ACTIVE | CLOSED
  operator       String   @default("Keeta OPS")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant                   @relation(fields: [tenantId], references: [id])
  partner Partner                  @relation(fields: [partnerId], references: [id])
  goals   IncentiveGoal[]
  tiers   IncentiveTier[]
  payouts CourierIncentivePayout[]

  @@unique([tenantId, partnerId, period, vehicleType])
  @@index([tenantId, period])
}

model IncentiveGoal {
  id           String @id @default(uuid())
  roundId      String
  name         String // ORDER_COMPLETION_PCT | ON_TIME_RATE
  weight       Float
  targetValue  Float
  minThreshold Float

  round IncentiveTargetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
}

model IncentiveTier {
  id      String @id @default(uuid())
  roundId String
  kind    String // EXPERIENCE | VALID_DA
  level   String // A | B | C | D
  minRate Float
  maxRate Float
  payment Int

  round IncentiveTargetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, kind])
}

model CourierIncentivePayout {
  id               String   @id @default(uuid())
  tenantId         String
  roundId          String
  driverId         String
  experienceRate   Float    @default(0)
  experienceTier   String?
  experiencePayKwd Int      @default(0)
  validDaCount     Int      @default(0)
  validDaTier      String?
  validDaPayKwd    Int      @default(0)
  totalPayKwd      Int      @default(0)
  computedAt       DateTime @default(now())

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  round  IncentiveTargetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  driver Driver               @relation(fields: [driverId], references: [id])

  @@unique([roundId, driverId])
  @@index([tenantId, driverId])
}

// F12 — Financial management
enum BillingStatus {
  PENDING_INVOICE
  AWAITING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

enum TaxInvoiceStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  WITHDRAWN
  FAILED
}

model Billing {
  id            String        @id @default(uuid())
  tenantId      String
  partnerId     String
  groupId       String
  groupName     String
  billingId     String        @unique
  billType      String // MONTHLY_SETTLEMENT | ADJUSTMENT
  period        String // "202604"
  billingDate   DateTime
  invoiceAmount Decimal       @db.Decimal(18, 3)
  payableAmount Decimal       @db.Decimal(18, 3)
  status        BillingStatus @default(PENDING_INVOICE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  partner     Partner             @relation(fields: [partnerId], references: [id])
  taxInvoice  TaxInvoice?
  withdrawals PaymentWithdrawal[]

  @@index([tenantId, period])
  @@index([tenantId, status])
}

model TaxInvoice {
  id           String           @id @default(uuid())
  tenantId     String
  billingId    String           @unique
  invoiceNo    String
  issueDate    DateTime
  sellerName   String
  totalAmount  Decimal          @db.Decimal(18, 3)
  fileUrl      String?
  status       TaxInvoiceStatus @default(DRAFT)
  rejectReason String?
  submittedAt  DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  billing Billing @relation(fields: [billingId], references: [id])

  @@index([tenantId, status])
}

model PaymentWithdrawal {
  id              String           @id @default(uuid())
  tenantId        String
  billingId       String
  groupId         String
  groupName       String
  withdrawTime    DateTime
  tailNumber      String
  amountKwd       Decimal          @db.Decimal(18, 3)
  status          WithdrawalStatus @default(PENDING)
  operationStatus String           @default("Withdrawn")
  note            String           @default("SYSTEM AUTO WITHDRAW")
  createdAt       DateTime         @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  billing Billing @relation(fields: [billingId], references: [id])

  @@index([tenantId, withdrawTime])
}

// ─── Agent Runtime (v2) ──────────────────────────────────────────────────────
// One AgentRunLog per agent invocation. AgentToolCall rows record every tool
// the agent called during that run. PendingAgentAction is the human approval
// queue for write tools that didn't meet the auto-execute threshold.

model AgentRunLog {
  id               String    @id @default(cuid())
  tenantId         String
  agentId          String // "triage" | "reconciliation" | "narrator" | "chat"
  triggerEvent     String // e.g. "violation", "appeal_submitted", "cron:15m"
  model            String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String    @default("running") // running | completed | failed
  error            String?
  actionsProposed  Int       @default(0)
  actionsApproved  Int       @default(0)
  actionsRejected  Int       @default(0)
  feedback         Json?

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  toolCalls     AgentToolCall[]
  pending       PendingAgentAction[]
  agentActions  AgentAction[]
  agentMemories AgentMemory[]

  @@index([tenantId, agentId, startedAt])
  @@index([tenantId, status])
}

model AgentToolCall {
  id         String   @id @default(cuid())
  runId      String
  toolName   String
  input      Json
  output     Json?
  error      String?
  durationMs Int      @default(0)
  approvedBy String? // userId of approving operator, if human-gated
  executedAt DateTime @default(now())

  run AgentRunLog @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([toolName, executedAt])
}

model PendingAgentAction {
  id             String    @id @default(cuid())
  tenantId       String
  runId          String
  agentId        String
  toolName       String
  input          Json
  recommendation String // "approve" | "reject" | "escalate"
  confidence     Float     @default(0)
  reasoning      String
  priorityScore  Float     @default(0)
  subjectType    String? // "appeal" | "violation" | "cash_record" | ...
  subjectId      String?
  resolvedAt     DateTime?
  resolution     String? // "approved" | "rejected"
  overrideReason String?
  resolvedBy     String?
  createdAt      DateTime  @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  run    AgentRunLog @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt, priorityScore])
  @@index([tenantId, agentId, resolvedAt])
  @@index([subjectType, subjectId])
}

// ─── Agent Spine v2 — Phase 1 (audit ledger, memory, pinned views, snapshots, analytics) ───
// CON-audit-row-shape: AgentAction is the canonical record of every fired agent action.
// Distinct from AgentRunLog (one row per LLM invocation) and PendingAgentAction
// (one row per un-resolved write proposal). This is the row the founder sees
// when answering "what did Darb do for me last week?".

model AgentAction {
  id                          String    @id @default(cuid())
  tenantId                    String
  proposer                    String    @default("Darb")
  approverId                  String
  toolName                    String
  originalProposal            Json
  modificationsBeforeApproval Json?
  outcome                     String // "success" | "failure" | "rolled_back"
  reasoning                   String    @db.Text
  agentRunId                  String?
  modelName                   String?
  promptTokens                Int       @default(0)
  completionTokens            Int       @default(0)
  latencyMs                   Int       @default(0)
  errorMessage                String?
  subjectType                 String? // "Driver" | "Shift" | "CashRecord" | ...
  subjectId                   String?
  rolledBackAt                DateTime?
  rolledBackById              String?
  rollbackReason              String?
  // Phase 4 Wave 1 — chat-origin audit trail (T-04-W1-05 Repudiation mitigation).
  // `source` defaults to "decisions" so all existing /decisions writers continue
  // to write rows tagged "decisions" with zero code change; Wave 2's chat route
  // is the first writer of `source: "chat"` (+ chatThreadId + chatMessageId).
  source                      String    @default("decisions") // "decisions" | "chat" | "briefing" | "auto"
  chatThreadId                String?
  chatMessageId               String?
  createdAt                   DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  approver     User          @relation("AgentActionApprover", fields: [approverId], references: [id])
  agentRun     AgentRunLog?  @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  chatMessages ChatMessage[] @relation("ChatMessageProposal")

  @@index([tenantId, createdAt])
  @@index([tenantId, toolName, createdAt])
  @@index([tenantId, subjectType, subjectId])
  @@index([approverId])
  @@index([tenantId, source, createdAt])
}

// Append-only per-tenant key/value notes. Latest-by-key reads use orderBy createdAt desc.
// Source values: "agent_observation" | "user_correction" | "explicit_set".

model AgentMemory {
  id         String   @id @default(cuid())
  tenantId   String
  key        String
  value      Json
  confidence Float    @default(0.5)
  source     String?
  agentRunId String?
  createdAt  DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  agentRun AgentRunLog? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([tenantId, key, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
}

// Saved generated views per user. Phase 4 (chat) consumes; Phase 1 only ships the schema.
// viewType: "table" | "chart" | "kpi_strip" | "map" | "comparison".

model PinnedView {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  title            String
  description      String?  @db.Text
  viewType         String
  spec             Json
  sortOrder        Int      @default(0)
  pinnedAt         DateTime @default(now())
  lastViewedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Phase 4 Wave 1 — refresh behaviour + chat-origin link.
  // refreshFrequency: "on_open" (re-fetch on open), "live" (poll), "static" (snapshot).
  // UI-SPEC §3.2.7 — default is "on_open".
  refreshFrequency String   @default("on_open")
  sourceThreadId   String?
  sourceMessageId  String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation("PinnedViewOwner", fields: [userId], references: [id])

  @@index([tenantId, userId, sortOrder])
  @@index([userId, pinnedAt])
}

// Daily snapshot of the composite score and contributing components.
// Backs the Driver File 90-day trend (Phase 3 consumer).
// Computed once per day by a worker (Wave 2 ships the writer); tools READ from this table.

model PerformanceSnapshot {
  id                String     @id @default(cuid())
  tenantId          String
  driverId          String
  snapshotDate      DateTime // truncated to UTC midnight
  compositeScore    Int
  attendanceScore   Int
  deliveryScore     Int
  financialScore    Int
  equipmentScore    Int
  platformScore     Int
  trend             ScoreTrend @default(STABLE)
  ordersCount       Int        @default(0)
  shiftsCount       Int        @default(0)
  violationsCount   Int        @default(0)
  cashOutstandingKd Decimal?   @db.Decimal(10, 3)
  breakdown         Json?
  computedAt        DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tenantId, driverId, snapshotDate])
  @@index([tenantId, snapshotDate])
  @@index([driverId, snapshotDate])
}

// Lightweight in-product analytics. The agent uses this to "see itself" (DEC-add-metric-events).
// Phase 1 ships the table + a recordMetricEvent helper; querying is Phase 11+.

model MetricEvent {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  event      String
  properties Json?
  sessionId  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation("MetricEventActor", fields: [userId], references: [id])

  @@index([tenantId, event, createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

// ─── Phase 4 Wave 1 — Chat surface + scheduled briefings ───
// REQ-chat-global-access + REQ-chat-generated-dashboards + REQ-chat-scheduled-jobs.
// Tenant-scoped + user-scoped (defense in depth — see RESEARCH §"Per-User
// Searchable Chat History"). 90-day retention via archivedAt; chatHistoryService
// runs the cleanup. Standing-rule type kept on ScheduledBriefing for forward
// compatibility — Phase 12 (REQ-data-agent-rule) wires the firing engine.

model ChatThread {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  title         String    @default("New chat")
  pinned        Boolean   @default(false)
  source        String    @default("user") // "user" | "briefing"
  briefingId    String?
  lastMessageAt DateTime  @default(now())
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  user     User               @relation("ChatThreadOwner", fields: [userId], references: [id])
  briefing ScheduledBriefing? @relation(fields: [briefingId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([tenantId, userId, lastMessageAt(sort: Desc)])
  @@index([userId, pinned, lastMessageAt(sort: Desc)])
  @@index([tenantId, archivedAt])
}

model ChatMessage {
  id               String   @id @default(cuid())
  tenantId         String
  threadId         String
  role             String // "user" | "assistant" | "system"
  content          String   @db.Text
  views            Json     @default("[]")
  toolCalls        Json     @default("[]")
  proposalId       String?
  state            String   @default("complete") // queued|tool_running|streaming|complete|error|cancelled
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int      @default(0)
  modelName        String?
  errorMessage     String?
  createdAt        DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  thread   ChatThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  proposal AgentAction? @relation("ChatMessageProposal", fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([tenantId, createdAt])
}

model ScheduledBriefing {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  name       String
  cron       String
  prompt     String    @db.Text
  recipients Json      @default("[]")
  channels   Json      @default("[\"in_chat\"]")
  type       String    @default("briefing") // "briefing" | "standing_rule_v3"
  active     Boolean   @default(true)
  nextFireAt DateTime?
  lastFireAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  creator User         @relation("ScheduledBriefingCreator", fields: [userId], references: [id])
  threads ChatThread[]

  @@index([tenantId, active, nextFireAt])
  @@index([userId, active])
}

// ─── Darb 2.0 — B2B Delivery Fulfillment (Slice A1) ─────────────────────────

enum DeliveryOrderStatus {
  CREATED
  REJECTED
  DISPATCHING
  NO_DRIVER
  ASSIGNED
  // Revision 8 (#3): the driver is at the shop, waiting for the order to be
  // handed over. The board counts up from here so a shop can see how long its
  // own counter has kept a courier standing there.
  ARRIVED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

enum DeliveryOrderSource {
  FOODICS
  VENDOR_PORTAL
  SUPERVISOR
  PARTNER_API
}

enum PaymentMethod {
  COD
  PREPAID
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum WalletOwnerType {
  DRIVER_CASH
  VENDOR_PAYABLE
  PLATFORM_REVENUE
  PLATFORM_CLEARING
  /// Revision 14 — money a delivery company has deposited with Darb, not yet
  /// spent clearing its own drivers' cash-on-hand. Liability-like: CREDIT
  /// raises it, same polarity as VENDOR_PAYABLE.
  FLEET_CASH
}

enum WalletTxType {
  COD_SETTLEMENT
  PREPAID_SETTLEMENT
  REMITTANCE
  ADJUSTMENT
  VENDOR_PAYOUT
  REFUND
  TIP
  FLEET_PAYOUT
  /// Revision 14 — a delivery company paying into its own cash account.
  FLEET_DEPOSIT
  /// Revision 10 (#2) — a merchant paying money into their own wallet. Its own
  /// type rather than an ADJUSTMENT so a shop reading its ledger can tell what
  /// it paid in apart from what Darb corrected.
  TOP_UP
}

enum IncidentType {
  SOS
  ACCIDENT
  VEHICLE_BREAKDOWN
  CUSTOMER_ISSUE
  OTHER
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum FoodicsConnStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// D1. Vendor - restaurant / merchant that sends us delivery orders
model Vendor {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  nameAr          String?
  code            String // short code used in order numbers, e.g. "BRGB"
  phone           String?
  requiresCarOnly Boolean  @default(false)
  isPaused        Boolean  @default(false) // paused vendors get orders REJECTED (VENDOR_PAUSED)
  // PRD §11 credit line: NULL = no cap. When the vendor's outstanding debt
  // (negative VENDOR_PAYABLE balance) reaches the cap, new orders are
  // REJECTED (VENDOR_CREDIT_CAP) until settled.
  creditCapKwd    Decimal? @db.Decimal(10, 3)
  // Revision 4 (#7) — the delivery plan this merchant is priced on. NULL
  // falls through to FulfillmentSettings + ZoneSurcharge, which is how every
  // vendor is priced until a plan is assigned.
  deliveryPlanId  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  branches          VendorBranch[]
  users             User[]
  orders            DeliveryOrder[]
  foodicsConnection FoodicsConnection?
  apiKeys           ApiKey[]
  statements        VendorStatement[]
  refunds           Refund[]
  deliveryPlan      DeliveryPlan?          @relation(fields: [deliveryPlanId], references: [id])
  accountManagers   AccountManagerVendor[]

  supportTickets SupportTicket[]
  topUps         VendorTopUp[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// D2. VendorBranch - physical pickup location; zoneId resolved point-in-polygon
//     at save time and re-resolved on zone edits.
model VendorBranch {
  id              String   @id @default(uuid())
  tenantId        String
  vendorId        String
  name            String
  nameAr          String?
  address         String?
  phone           String?
  lat             Decimal? @db.Decimal(10, 7)
  lng             Decimal? @db.Decimal(10, 7)
  zoneId          String?
  // Revision 5 (#6). The client asked for pricing plan assignment to sit with
  // the branches rather than as its own tab, so a branch may carry its own
  // plan. NULL inherits the vendor's plan, which is what every existing branch
  // does — this ships with no backfill and no repricing.
  deliveryPlanId  String?
  foodicsBranchId String?
  // Revision 10 (#7). Pausing used to be one switch for the whole account, so a
  // shop with a queue at one counter had to stop taking orders everywhere. A
  // branch is paused when either this flag or the vendor's own is set, which
  // keeps the account-wide switch working exactly as it did.
  isPaused        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  vendor       Vendor          @relation(fields: [vendorId], references: [id])
  zone         DeliveryZone?   @relation(fields: [zoneId], references: [id])
  deliveryPlan DeliveryPlan?   @relation(fields: [deliveryPlanId], references: [id])
  orders       DeliveryOrder[]
  // Revision 1 (#9) — portal users scoped to this branch.
  portalUsers  User[]          @relation("BranchPortalUser")

  @@unique([tenantId, foodicsBranchId])
  @@index([tenantId])
  @@index([vendorId])
}

// D3. DeliveryZone - GeoJSON polygon ([lng,lat] ring) with a precomputed bbox
//     prefilter [minLng, minLat, maxLng, maxLat] and centroid.
model DeliveryZone {
  id          String   @id @default(uuid())
  tenantId    String
  code        String // e.g. "SALMIYA"
  name        String
  nameAr      String?
  polygon     Json // GeoJSON Polygon geometry, coordinates in [lng, lat] order
  bbox        Json // [minLng, minLat, maxLng, maxLat]
  centroidLat Decimal? @db.Decimal(10, 7)
  centroidLng Decimal? @db.Decimal(10, 7)
  // Revision 1 (#8) — the polygon editor has always sent a colour; without a
  // column to hold it every zone edit silently discarded it and the list dot
  // fell back to Darb green, which read as "zone edits do not save".
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  branches         VendorBranch[]
  originSurcharges ZoneSurcharge[]        @relation("SurchargeOrigin")
  destSurcharges   ZoneSurcharge[]        @relation("SurchargeDest")
  pickupOrders     DeliveryOrder[]        @relation("OrderPickupZone")
  dropoffOrders    DeliveryOrder[]        @relation("OrderDropoffZone")
  planOriginRates  DeliveryPlanZoneRate[] @relation("PlanRateOrigin")
  planDestRates    DeliveryPlanZoneRate[] @relation("PlanRateDest")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// D4. ZoneSurcharge - cross-zone delivery surcharge. Absence of a row for an
//     (origin, dest) pair means the pair is unserviceable.
model ZoneSurcharge {
  id           String   @id @default(uuid())
  tenantId     String
  originZoneId String
  destZoneId   String
  surchargeKwd Decimal  @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  originZone DeliveryZone @relation("SurchargeOrigin", fields: [originZoneId], references: [id])
  destZone   DeliveryZone @relation("SurchargeDest", fields: [destZoneId], references: [id])

  @@unique([tenantId, originZoneId, destZoneId])
  @@index([tenantId])
}

// ─── Revision 4 (#7): delivery plans ────────────────────────────────────────
//
// A plan is a named, reusable price list that a merchant is assigned to. It is
// deliberately one thing or the other: a plan prices by zone OR by kilometre,
// never both, because a plan that could do either is a plan nobody can read off
// a screen and say what a delivery costs.
//
// ZoneSurcharge above is not extended in place — it is tenant-wide and every
// vendor shares it. Plans need per-plan rates, and the two have to coexist
// while vendors migrate onto plans one at a time.

enum DeliveryPlanType {
  ZONE
  KM
}

model DeliveryPlan {
  id              String           @id @default(uuid())
  tenantId        String
  name            String // client-facing, e.g. "Pharmacy standard"
  type            DeliveryPlanType
  // Revision 5 (#7). The intra-zone flat fee belongs to the plan, not to the
  // tenant: "whenever we create a plan, the intra-zone flat fee will be with
  // each plan". NULL on a by-zone plan falls back to the origin==dest cell of
  // the grid, which is where the value used to live, so plans written before
  // this column keep pricing exactly as they did.
  intraZoneFeeKwd Decimal?         @db.Decimal(10, 3)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  zoneRates DeliveryPlanZoneRate[]
  kmTiers   DeliveryPlanKmTier[]
  vendors   Vendor[]
  branches  VendorBranch[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// One cell of a by-zone plan's grid. originZoneId == destZoneId is the
// intra-zone flat fee. A missing row for a cross-zone pair means the pair is
// unserviceable — the same absence-is-meaningful rule ZoneSurcharge uses, which
// is what lets the pricing UI express "unserviceable" as an empty cell.
model DeliveryPlanZoneRate {
  id           String   @id @default(uuid())
  tenantId     String
  planId       String
  originZoneId String
  destZoneId   String
  feeKwd       Decimal  @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan       DeliveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  originZone DeliveryZone @relation("PlanRateOrigin", fields: [originZoneId], references: [id])
  destZone   DeliveryZone @relation("PlanRateDest", fields: [destZoneId], references: [id])

  @@unique([planId, originZoneId, destZoneId])
  @@index([tenantId])
}

// One band of a by-kilometre plan, ordered by maxKm ascending. The last tier
// carries maxKm = NULL, meaning "and above" — that is what makes "14+ km" a
// row rather than a special case in the pricing code. feeKwd = NULL marks the
// band unserviceable, mirroring the blank cell in the by-zone grid.
model DeliveryPlanKmTier {
  id        String   @id @default(uuid())
  tenantId  String
  planId    String
  sortOrder Int      @default(0)
  maxKm     Decimal? @db.Decimal(6, 2)
  feeKwd    Decimal? @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan DeliveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@index([tenantId])
}

// Google Distance Matrix results, keyed on coordinates rounded to 4dp (~11 m).
// Repeat orders from one branch to one building are the common case, so the
// cache absorbs most of the traffic and the API bill stays small.
model DistanceCache {
  id        String   @id @default(uuid())
  tenantId  String
  originKey String // "lat,lng" rounded to 4dp
  destKey   String
  km        Decimal  @db.Decimal(8, 3)
  source    String // google | straight-line
  fetchedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, originKey, destKey])
  @@index([fetchedAt])
}

// D5. FulfillmentSettings - one row per tenant; dispatch + pricing knobs
model FulfillmentSettings {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  intraZoneFeeKwd        Decimal  @default(1.250) @db.Decimal(10, 3)
  driverCashCeilingKwd   Decimal  @default(100.000) @db.Decimal(10, 3)
  offerWindowSec         Int      @default(15)
  maxOfferRounds         Int      @default(8)
  searchRadiusKm         Float    @default(8)
  gpsStaleAfterSec       Int      @default(180)
  // PRD §8 dispatch: progressive radius widening across offer rounds.
  radiusWidenAfterRounds Int      @default(3)
  radiusWidenFactor      Float    @default(1.5)
  maxSearchRadiusKm      Float    @default(15)
  // PRD §8 dispatch: auto-batching (one pickup, multiple drops only).
  batchingEnabled        Boolean  @default(true)
  batchMaxDropKm         Float    @default(1.5)
  batchMaxOrders         Int      @default(2)
  // Revision 5 (#1): every order must be served. When nobody is free, the
  // offer goes to the nearest driver who is about to finish the drop he is
  // already on. "About to finish" is this many minutes of projected remaining
  // travel; 0 disables the reserve tier and restores the old free-drivers-only
  // behaviour.
  finishingSoonMinutes   Int      @default(10)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// D6. DeliveryOrder - core Darb 2.0 order (Foodics webhook, vendor portal, or
//     supervisor manual). Coarse status FSM; granular milestones live in
//     OrderEvent rows keyed by this id.
model DeliveryOrder {
  id                 String              @id @default(uuid())
  tenantId           String
  orderNumber        String // "DRB-{vendorCode}-{seq}"
  source             DeliveryOrderSource
  foodicsOrderId     String?
  vendorId           String
  branchId           String
  status             DeliveryOrderStatus @default(CREATED)
  paymentMethod      PaymentMethod       @default(COD)
  orderTotalKwd      Decimal             @db.Decimal(10, 3)
  deliveryFeeKwd     Decimal?            @db.Decimal(10, 3)
  customerName       String?
  customerPhone      String?
  dropoffAddress     String?
  dropoffLat         Decimal?            @db.Decimal(10, 7)
  dropoffLng         Decimal?            @db.Decimal(10, 7)
  pickupZoneId       String?
  dropoffZoneId      String?
  driverId           String?
  offerRound         Int                 @default(0)
  // Revision 4 (#1) — NO_DRIVER is no longer a dead end. exhaustDispatch
  // stamps these, the sweep reads them, and the retry rounds they drive
  // search without a radius cap so the nearest driver anywhere wins.
  redispatchAttempts Int                 @default(0)
  nextRedispatchAt   DateTime?
  requiresCarOnly    Boolean             @default(false)
  rejectionReason    String? // OUT_OF_ZONE_DROPOFF | UNSERVICEABLE_PAIR | NO_COORDINATES | BRANCH_UNZONED | VENDOR_PAUSED | BRANCH_PAUSED | VENDOR_CREDIT_CAP
  cancelReason       String?
  failureReason      String?
  proofPhotoUrl      String?
  podPin             String? // 4-digit PIN generated at creation
  codCollectedKwd    Decimal?            @db.Decimal(10, 3)
  slaDeadline        DateTime?
  // PRD §6 scheduling: NULL = immediate. Scheduled orders persist as CREATED
  // and are advanced to DISPATCHING by the cron sweep near the due time.
  scheduledAt        DateTime?
  // PRD §6 return-to-merchant: set on the FAILED→RETURNED transition.
  returnedAt         DateTime?
  // PRD §8 auto-batching: set at accept time when the driver won a batched
  // offer (one pickup, multiple drops). NULL for single-order trips.
  batchId            String?
  // PRD §11 tips: customer tip via the tracking link; driver keeps 100%.
  tipKwd             Decimal?            @db.Decimal(10, 3)
  // PRD §12 tracking link credential: 128-bit random, the only auth for the
  // public /api/track surface. NULL only on pre-PRD historical rows.
  trackingToken      String?             @unique
  // PRD §2 partner intake idempotency: the merchant system's own order id.
  externalRef        String?
  // PRD §11 refunds: set when a full-order refund is PROCESSED.
  refundedAt         DateTime?
  assignedAt         DateTime?
  // Revision 8 (#3): when the driver reached the shop. The wait the board
  // counts up is arrivedAt to pickedUpAt, which is the shop's own handover.
  arrivedAt          DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  vendor      Vendor          @relation(fields: [vendorId], references: [id])
  branch      VendorBranch    @relation(fields: [branchId], references: [id])
  driver      Driver?         @relation(fields: [driverId], references: [id])
  pickupZone  DeliveryZone?   @relation("OrderPickupZone", fields: [pickupZoneId], references: [id])
  dropoffZone DeliveryZone?   @relation("OrderDropoffZone", fields: [dropoffZoneId], references: [id])
  offers      DispatchOffer[]
  incidents   Incident[]
  rating      OrderRating?
  refund      Refund?

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, foodicsOrderId])
  @@unique([tenantId, vendorId, externalRef])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, vendorId, createdAt])
  @@index([driverId, status])
  @@index([tenantId, slaDeadline])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, batchId])
  // The sweep's retry leg selects on exactly this pair.
  @@index([status, nextRedispatchAt])
}

// D7. DispatchOffer - one serialized 15s offer to one driver per round
model DispatchOffer {
  id          String      @id @default(uuid())
  tenantId    String
  orderId     String
  driverId    String
  round       Int
  distanceKm  Float?
  // PRD §8 auto-batching: offers created together for one driver share a
  // batchId; accept/decline/expire act on the whole batch.
  batchId     String?
  status      OfferStatus @default(OFFERED)
  offeredAt   DateTime    @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  DeliveryOrder @relation(fields: [orderId], references: [id])
  driver Driver        @relation(fields: [driverId], references: [id])

  @@unique([orderId, driverId, round])
  @@index([tenantId, status])
  @@index([driverId, status])
  @@index([batchId])
}

// D8. WalletAccount - one ledger account per owner; balanceKwd is a cache,
//     the WalletEntry rows are the source of truth.
model WalletAccount {
  id         String          @id @default(uuid())
  tenantId   String
  ownerType  WalletOwnerType
  ownerKey   String // "DRIVER:{id}" | "VENDOR:{id}" | "PLATFORM_REVENUE" | "PLATFORM_CLEARING"
  balanceKwd Decimal         @default(0) @db.Decimal(10, 3)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  entries WalletEntry[]

  @@unique([tenantId, ownerKey])
  @@index([tenantId, ownerType])
}

// D9. WalletTransaction - append-only double-entry transaction header.
//     No update/delete code paths; corrections are compensating transactions.
model WalletTransaction {
  id             String       @id @default(uuid())
  tenantId       String
  type           WalletTxType
  idempotencyKey String       @unique // "cod-settle:{orderId}", "remit:{id}", ...
  orderId        String?
  remittanceId   String?
  memo           String?
  createdById    String?
  createdAt      DateTime     @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  entries WalletEntry[]

  @@index([tenantId, createdAt])
  @@index([orderId])
}

// D10. WalletEntry - balanced debit/credit legs of a WalletTransaction
model WalletEntry {
  id                String   @id @default(uuid())
  tenantId          String
  transactionId     String
  accountId         String
  direction         String // DEBIT | CREDIT
  amountKwd         Decimal  @db.Decimal(10, 3) // always > 0
  runningBalanceKwd Decimal  @db.Decimal(10, 3)
  createdAt         DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  transaction WalletTransaction @relation(fields: [transactionId], references: [id])
  account     WalletAccount     @relation(fields: [accountId], references: [id])

  @@index([tenantId])
  @@index([transactionId])
  @@index([accountId, createdAt])
}

// D11. Remittance - driver hands collected cash to the hub
model Remittance {
  id             String        @id @default(uuid())
  tenantId       String
  driverId       String
  amountKwd      Decimal       @db.Decimal(10, 3)
  method         DepositMethod
  receiptUrl     String?
  receivedById   String?
  /// Revision 14 — set when the delivery company cleared this driver out of its
  /// own deposited cash account rather than the driver handing notes to Darb.
  /// Null is the original hand-in at the cash desk, which is why this is one
  /// table: a driver's cash history is one list whoever settled it.
  fleetPartnerId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  driver       Driver        @relation(fields: [driverId], references: [id])
  fleetPartner FleetPartner? @relation(fields: [fleetPartnerId], references: [id])

  @@index([tenantId, createdAt])
  @@index([driverId, createdAt])
  @@index([tenantId, fleetPartnerId, createdAt])
}

// D12. WalletReconciliationRun - nightly invariant checks over the ledger
model WalletReconciliationRun {
  id        String   @id @default(uuid())
  tenantId  String
  runDate   DateTime
  status    String // OK | MISMATCH
  checks    Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, runDate])
  @@index([tenantId, status])
}

// D13. Incident - SOS + operational incidents raised from the driver app
model Incident {
  id               String         @id @default(uuid())
  tenantId         String
  type             IncidentType
  status           IncidentStatus @default(OPEN)
  severity         String         @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  driverId         String
  orderId          String?
  lat              Decimal?       @db.Decimal(10, 7)
  lng              Decimal?       @db.Decimal(10, 7)
  description      String?
  reportedVia      String? // APP, PHONE
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNote   String?
  metadata         Json? // photo R2 keys etc.
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  driver Driver         @relation(fields: [driverId], references: [id])
  order  DeliveryOrder? @relation(fields: [orderId], references: [id])

  @@index([tenantId, status])
  @@index([driverId, createdAt])
}

// D14. FoodicsConnection - per-vendor Foodics OAuth connection
model FoodicsConnection {
  id             String            @id @default(uuid())
  tenantId       String
  vendorId       String            @unique
  accessTokenEnc String? // AES-256-GCM encrypted (env FOODICS_TOKEN_KEY)
  orderTagId     String? // only orders tagged with this tag are ingested
  webhookSecret  String
  status         FoodicsConnStatus @default(PENDING)
  lastEventAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
}

// D15. WebhookEvent - raw inbound webhook idempotency log. Intentionally NOT
//      tenant-scoped: rows are written before the tenant is resolved.
model WebhookEvent {
  id          String             @id @default(uuid())
  provider    String // "foodics"
  eventKey    String             @unique // idempotency key derived from the payload
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())

  @@index([status, createdAt])
}

// ── Darb 2.0 PRD build (DARB2-PRD-001 v3.0) ────────────────────────────────

// D16. ApiKey - partner order-intake credential (PRD §2: orders arrive
//      ready-made via API). The raw key is shown once at creation; only its
//      sha256 hash is stored. Auth attaches {tenantId, vendorId} to the
//      request, so a key is always scoped to exactly one merchant.
model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  vendorId    String
  name        String // operator label, e.g. "Royal POS integration"
  keyHash     String    @unique // sha256(rawKey)
  keyPrefix   String // first 8 chars of the raw key, for support lookups
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([tenantId, vendorId])
}

// D17. OrderRating - customer 1-5 star rating from the tracking link
//      (PRD §12). One per order; stars <= 2 feed the violation ladder
//      (LOW_CUSTOMER_RATING).
model OrderRating {
  id        String   @id @default(uuid())
  tenantId  String
  orderId   String   @unique
  driverId  String
  stars     Int // 1..5, validated at the route layer
  comment   String?
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  DeliveryOrder @relation(fields: [orderId], references: [id])
  driver Driver        @relation(fields: [driverId], references: [id])

  @@index([tenantId, driverId, createdAt])
}

// D18. VendorStatement - monthly netting statement per merchant (PRD §11:
//      "at month-end the net decides who pays whom"). Idempotent on
//      (tenantId, vendorId, periodStart). closingBalance > 0 = Darb owes the
//      vendor; payout posts a VENDOR_PAYOUT wallet transaction.
model VendorStatement {
  id                String   @id @default(uuid())
  tenantId          String
  vendorId          String
  periodStart       DateTime // first day of month, 00:00 UTC
  periodEnd         DateTime // exclusive
  openingBalanceKwd Decimal  @db.Decimal(10, 3)
  codNetKwd         Decimal  @db.Decimal(10, 3) // Σ COD (total - fee) credited
  prepaidFeesKwd    Decimal  @db.Decimal(10, 3) // Σ prepaid fees debited
  refundsKwd        Decimal  @default(0) @db.Decimal(10, 3)
  closingBalanceKwd Decimal  @db.Decimal(10, 3)
  status            String   @default("FINAL") // FINAL | PAID
  payoutTxId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([tenantId, vendorId, periodStart])
  @@index([tenantId, periodStart])
}

// D19. Refund - full-order refund (PRD §11: merchant approves, Darb
//      processes). One per order. Processing posts a compensating REFUND
//      wallet transaction; driver cash is never touched.
model Refund {
  id            String   @id @default(uuid())
  tenantId      String
  orderId       String   @unique
  vendorId      String
  amountKwd     Decimal  @db.Decimal(10, 3) // orderTotalKwd snapshot
  reason        String
  status        String   @default("REQUESTED") // REQUESTED | PROCESSED | REJECTED
  requestedById String?
  processedById String?
  walletTxId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  DeliveryOrder @relation(fields: [orderId], references: [id])
  vendor Vendor        @relation(fields: [vendorId], references: [id])

  @@index([tenantId, status])
}

// D20. FleetPartner - subcontracted delivery company (PRD §9: Darb employs
//      no drivers; fleets are onboarded, governed and paid a flat per-order
//      rate). Deliberately separate from the legacy Company model, which is
//      welded to the aggregator platforms.
model FleetPartner {
  id                   String   @id @default(uuid())
  tenantId             String
  name                 String
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  flatFeePerOrderKwd   Decimal  @default(1.100) @db.Decimal(10, 3)
  minOnlineHoursPerDay Float?
  minDriversOnline     Json? // { "<zoneId>": n } contractual commitment
  disciplineStatus     String   @default("OK") // OK | WARNED | THROTTLED | SUSPENDED | REMOVED
  disciplineNote       String?
  isActive             Boolean  @default(true)
  // Revision 1 (#15/#27/#28) — Sidra, Marina and Nakheel are the same owner.
  // One login reaches the whole group and reporting can be combined.
  ownerGroupId         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  ownerGroup     OwnerGroup?            @relation(fields: [ownerGroupId], references: [id])
  drivers        Driver[]
  users          User[]
  statements     FleetPayoutStatement[]
  // Revision 12 — the portal's request desk.
  documents      FleetDocument[]
  changeRequests FleetChangeRequest[]
  issues         FleetIssue[]
  supportTickets SupportTicket[]
  payoutInvoices FleetPayoutInvoice[]
  // Revision 14 — the company's own cash account with Darb.
  cashDeposits   FleetCashDeposit[]
  remittances    Remittance[]

  @@index([tenantId, isActive])
  @@index([tenantId, ownerGroupId])
}

// D21. FleetPayoutStatement - monthly fleet payout (PRD §11: delivered
//      orders x flat fee, fleets paid monthly). feePerOrderKwd is snapshotted
//      so a rate change never rewrites history. Payment posts a FLEET_PAYOUT
//      wallet transaction.
model FleetPayoutStatement {
  id              String    @id @default(uuid())
  tenantId        String
  fleetPartnerId  String
  periodStart     DateTime
  periodEnd       DateTime // exclusive
  deliveredOrders Int
  feePerOrderKwd  Decimal   @db.Decimal(10, 3)
  totalKwd        Decimal   @db.Decimal(10, 3)
  /// Revision 13 (#8) — FINAL | CONFIRMED | DISPUTED | PAID. The delivery
  /// company confirms a statement before Darb processes it; postFleetPayout
  /// refuses anything that is not CONFIRMED, so the gate holds for the cron
  /// and a script as well as the staff button.
  status          String    @default("FINAL")
  payoutTxId      String?
  confirmedAt     DateTime?
  confirmedById   String?
  disputedAt      DateTime?
  disputeReason   String?
  /// The SupportTicket a dispute opened, so the disagreement lands in the
  /// inbox Darb already triages rather than in a WhatsApp thread.
  disputeTicketId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  fleet   FleetPartner        @relation(fields: [fleetPartnerId], references: [id])
  /// Revision 13b — the company-stamped invoice that confirmation requires.
  invoice FleetPayoutInvoice?

  @@unique([tenantId, fleetPartnerId, periodStart])
  @@index([tenantId, periodStart])
}

/// Revision 13b (client note) — the stamped invoice a delivery company uploads
/// when it confirms a payout statement.
///
/// Its own table rather than a FleetDocument: a company document is a licence
/// Darb reviews for validity and expiry, and this is an accounting artefact
/// bound one-to-one to a statement. Putting it in FleetDocument would have it
/// appear on the Documents tab wearing a review status that means nothing here.
///
/// `fileKey` is a private R2 object when storage is configured. `fileData` is
/// the fallback while it is not: production has no R2 yet, and a confirmation
/// gate nobody can pass is worse than a megabyte in Postgres. One row per
/// statement per month, so this is a dozen rows a year per company.
// D. DeliveryPhoto (2026-08-01) - proof-of-delivery and arrival photos when
//    object storage is not configured.
//
//    Why this exists: removing the PIN made a photo the ONLY way to complete a
//    delivery, and the photo path presigns a PUT to R2. On an environment with
//    no R2 credentials that presign throws, the app queues the POD forever, and
//    no driver can finish a job. A delivery platform that cannot complete a
//    delivery is not degraded, it is stopped.
//
//    Same shape and the same reasoning as FleetPayoutInvoice: `fileKey` is
//    preferred and these bytes are the fallback, so nothing needs migrating the
//    day R2 is switched on.
model DeliveryPhoto {
  id        String   @id @default(uuid())
  tenantId  String
  /// The storage key the rest of the system already passes around, so a photo
  /// stored here is addressed exactly like one stored in R2.
  key       String   @unique
  orderId   String
  driverId  String?
  mimeType  String   @default("image/jpeg")
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, orderId])
}

model FleetPayoutInvoice {
  id             String   @id @default(uuid())
  tenantId       String
  fleetPartnerId String
  statementId    String   @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  fileKey        String?
  fileData       Bytes?
  uploadedById   String?
  uploadedAt     DateTime @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleet      FleetPartner         @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)
  statement  FleetPayoutStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  uploadedBy User?                @relation("FleetPayoutInvoiceUploader", fields: [uploadedById], references: [id])

  @@index([tenantId, fleetPartnerId])
}

// ─── Revision 12: the fleet portal becomes a request desk ───────────────────
//
// The delivery company portal was three read-only screens. It can now hand
// Darb documents, put drivers forward, report a resignation and answer
// operational issues. The rule that shapes all of it: THE FLEET PORTAL NEVER
// WRITES A LIVE RECORD. Everything is a request, and Darb's approval is what
// mutates anything real. A subcontractor putting an undocumented driver on the
// road without Darb seeing the documents is the failure this prevents.
//
// One exception, decided by the client: the driver's phone number writes
// through directly (PATCH /api/fleet/drivers/:id/phone). Drivers change SIMs
// constantly and a review queue between a driver and their own number strands
// them. The cost is real: phone is the driver app's sign-in identity.

enum FleetDocumentStatus {
  /// Uploaded by the fleet, waiting on Darb.
  PENDING_REVIEW
  VALID
  REJECTED
  EXPIRED
  /// Replaced by a newer upload of the same type. Never deleted: the history
  /// of what a fleet showed Darb and when is the point of the table.
  SUPERSEDED
}

/// One table for both company and driver documents. `driverId` null means the
/// document belongs to the delivery company itself.
model FleetDocument {
  id              String              @id @default(uuid())
  tenantId        String
  fleetPartnerId  String
  /// Null until a DRIVER_ONBOARD request is approved and the Driver exists.
  driverId        String?
  /// Company: TRADE_LICENSE | COMMERCIAL_REG | CIVIL_INSURANCE | VAT_CERT
  /// Driver:  CIVIL_ID | DRIVING_LICENSE | VEHICLE_REG | VEHICLE_INSURANCE |
  ///          HEALTH_CERT | WORK_PERMIT | FOOD_HANDLING
  type            String
  /// Private R2 object key. Never a public URL: reads go through a signed GET.
  /// Null when the fleet submitted an expiry date with no file, which is what
  /// the portal falls back to while R2 is unconfigured.
  fileKey         String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  expiryDate      DateTime?
  status          FleetDocumentStatus @default(PENDING_REVIEW)
  rejectionReason String?
  uploadedById    String?
  reviewedById    String?
  reviewedAt      DateTime?
  supersededById  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleet      FleetPartner @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)
  driver     Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  uploadedBy User?        @relation("FleetDocumentUploader", fields: [uploadedById], references: [id])
  reviewedBy User?        @relation("FleetDocumentReviewer", fields: [reviewedById], references: [id])

  @@index([tenantId, fleetPartnerId, status])
  @@index([tenantId, driverId, type])
  @@index([tenantId, status, expiryDate])
}

enum FleetChangeRequestType {
  DRIVER_ONBOARD
  DRIVER_STATUS
  DRIVER_PROFILE
  DRIVER_DOCUMENT
  COMPANY_DOCUMENT
}

enum FleetChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// The fleet pulled it back before Darb decided.
  WITHDRAWN
}

/// The reviewable unit. This is a table rather than a pending flag on each
/// record because "Anil resigned" has no record of its own to carry a flag.
///
/// A pending driver has NO `Driver` row: approval creates it. A rejected
/// submission therefore cannot leave a half-driver in the dispatch candidate
/// pool, and `Driver.status` keeps meaning exactly what it means today.
model FleetChangeRequest {
  id             String                   @id @default(uuid())
  tenantId       String
  fleetPartnerId String
  type           FleetChangeRequestType
  /// Set for everything except DRIVER_ONBOARD and COMPANY_DOCUMENT.
  driverId       String?
  /// The proposed values. Shape depends on `type`; the service that applies an
  /// approval is the only thing that reads it.
  payload        Json
  /// FleetDocument ids this request is asking Darb to look at.
  documentIds    String[]                 @default([])
  status         FleetChangeRequestStatus @default(PENDING)
  requestedById  String?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleet       FleetPartner @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  requestedBy User?        @relation("FleetRequestRequester", fields: [requestedById], references: [id])
  reviewedBy  User?        @relation("FleetRequestReviewer", fields: [reviewedById], references: [id])

  @@index([tenantId, fleetPartnerId, status])
  @@index([tenantId, status, createdAt])
}

enum FleetIssueType {
  LATE_LOGIN
  NO_ORDERS
  RATING_DROP
  DOC_EXPIRING
  ACCEPTANCE_LOW
}

enum FleetIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  /// Open too long. Shows on Darb's side against the fleet.
  ESCALATED
}

enum FleetIssueSeverity {
  LOW
  MEDIUM
  HIGH
}

/// Darb's system opens these; the delivery company closes them. That is the
/// opposite direction of travel from SupportTicket, which is why it is its own
/// tab and not a ticket type: a supervisor works an inbox of things Darb has
/// noticed, calls the driver, and records what they did about it.
model FleetIssue {
  id               String             @id @default(uuid())
  tenantId         String
  fleetPartnerId   String
  driverId         String?
  type             FleetIssueType
  severity         FleetIssueSeverity @default(MEDIUM)
  title            String
  detail           String
  data             Json?
  status           FleetIssueStatus   @default(OPEN)
  /// `{type}:{driverId}:{YYYY-MM-DD}`, or `{type}:{driverId}` for standing
  /// ones. What stops the nightly sweep raising the same issue every night.
  dedupeKey        String
  openedAt         DateTime           @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  /// Required to resolve. An acknowledge button with no account of the fix is
  /// a button that gets clicked to clear a badge.
  resolutionNote   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleet          FleetPartner @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)
  driver         Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  acknowledgedBy User?        @relation("FleetIssueAcknowledger", fields: [acknowledgedById], references: [id])
  resolvedBy     User?        @relation("FleetIssueResolver", fields: [resolvedById], references: [id])

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, fleetPartnerId, status])
  @@index([tenantId, status, openedAt])
}

// ─── Revision 4 (#12): invites, per-surface access, account managers ─────────

// An invite is the only way a staff account gets its first password. The admin
// never types one — they type a name, an email and a role, and the person on
// the other end chooses their own credential. Only the sha256 of the token is
// stored, so a database read cannot be replayed as an invite.
model UserInvite {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
}

// The staff surfaces a per-user grant can talk about. These are the rail
// entries, not API routes: the client asked "what he can view or change", and
// what a person can name is a screen.
enum AppSurface {
  LIVE
  ORDERS
  MONEY
  SETUP
  TODAY
  CASH_DESK
  PEOPLE
}

// A per-user override of the role default. Absence of a row means "inherit the
// role", which is what lets this ship with no backfill: every existing user has
// no rows and therefore behaves exactly as before.
model UserSurfacePermission {
  id        String          @id @default(uuid())
  tenantId  String
  userId    String
  surface   AppSurface
  level     PermissionLevel
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surface])
  @@index([tenantId])
}

// Which merchants an ACCOUNT_MANAGER owns. User.managedCompanies already
// exists but points at Company, the legacy multi-platform client model, which
// is not the Darb merchant — hence a separate join rather than a reuse.
model AccountManagerVendor {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  vendorId  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([tenantId, vendorId])
}

/// Revision 8 (#6) — a shop's support requests.
///
/// Raised from the vendor portal by any of the three shop roles, including
/// Order tracking, whose whole job is following deliveries and reporting when
/// one goes wrong. Kept deliberately small: a subject, a body, an optional
/// order it is about, and a thread of replies from both sides.
model SupportTicket {
  id             String              @id @default(uuid())
  tenantId       String
  /// Revision 12 — exactly ONE of vendorId / fleetPartnerId is set. Making
  /// vendorId nullable rather than adding a second ticket table keeps Darb on
  /// one support inbox; a duplicate table would have meant a second triage
  /// screen nobody remembers to open.
  vendorId       String?
  fleetPartnerId String?
  /// Who raised it, so the shop can see which of its own people asked.
  createdById    String?
  subject        String
  status         SupportTicketStatus @default(OPEN)
  /// Revision 9 (#6) — what the request is about, in the shop's own terms.
  type           SupportTicketType   @default(OTHER)
  /// The order this is about, when it is about one.
  orderId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor   Vendor?                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fleet    FleetPartner?          @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([tenantId, vendorId, status])
  @@index([tenantId, fleetPartnerId, status])
  @@index([tenantId, status, createdAt])
}

model SupportTicketMessage {
  id         String   @id @default(uuid())
  tenantId   String
  ticketId   String
  /// VENDOR or DARB — which side of the conversation this came from.
  author     String
  authorName String?
  body       String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  RESOLVED
  /// Revision 10 (#5) — the shop withdrew the request itself. Distinct from
  /// RESOLVED, which means Darb dealt with it: a cancelled request was never
  /// answered and should not count against anyone's response time.
  CANCELLED
}

/// Revision 10 (#2) — a shop paying money into its Darb wallet.
///
/// Top-up used to be a paragraph telling the merchant to make a bank transfer
/// quoting their shop code, and somebody at Darb matching it up by hand. This
/// row is the intent to pay: it carries the amount, a public token that is the
/// only credential the payment page needs, and the gateway's own reference once
/// there is one. The wallet credit is posted when the payment is confirmed,
/// keyed on `topup:{id}` so a replayed webhook cannot double-credit.
model VendorTopUp {
  id            String            @id @default(uuid())
  tenantId      String
  vendorId      String
  /// Who asked for it, so a shop can see which of its own people paid.
  requestedById String?
  amountKwd     Decimal           @db.Decimal(10, 3)
  status        VendorTopUpStatus @default(PENDING)
  /// 128-bit random, the only auth for the public /api/pay surface.
  token         String            @unique
  /// Human-quotable reference, e.g. "TOP-4F2A19".
  reference     String
  /// Where the merchant was sent to pay. A gateway URL when one is configured,
  /// otherwise the Darb-hosted payment page for this token.
  paymentUrl    String?
  /// The gateway's own id for this payment, once it has issued one.
  providerRef   String?
  /// "MYFATOORAH" | "MANUAL" — which rail actually took the money.
  provider      String?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([tenantId, vendorId, createdAt])
  @@index([tenantId, status])
}

enum VendorTopUpStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

// D. FleetCashDeposit (revision 14) - a delivery company paying Darb the cash
//    its drivers collected. Shaped on VendorTopUp and for the same reason: the
//    row records the INTENT to pay, and only an accountant confirming receipt
//    credits FLEET_CASH. Two divergences from a merchant top-up, both
//    deliberate: no payment gateway and no public token, because this is an
//    envelope or a bank transfer between two companies that both already have
//    logins, not a checkout link a stranger opens on a phone.
model FleetCashDeposit {
  id             String                 @id @default(uuid())
  tenantId       String
  fleetPartnerId String
  /// Which of the company's own logins submitted it.
  requestedById  String?
  amountKwd      Decimal                @db.Decimal(10, 3)
  method         DepositMethod          @default(BANK_TRANSFER)
  /// Human-quotable reference, e.g. "DEP-4F2A19".
  reference      String
  note           String?
  /// The company's own transfer slip or receipt photo, when there is one.
  receiptUrl     String?
  /// Revision 14b — the client asked for deposits to be paid by link only,
  /// exactly as a merchant tops up. 128-bit random, the only credential on the
  /// public /api/pay surface, and unique so a token resolves to one deposit.
  token          String?                @unique
  /// Where the company was sent to pay: the gateway's hosted checkout when one
  /// is configured, otherwise the Darb-hosted page carrying the amount and the
  /// reference. Never a dead button.
  paymentUrl     String?
  /// The gateway's own id for this payment, once it has issued one.
  providerRef    String?
  /// "MYFATOORAH" | "MANUAL" — which rail actually took the money.
  provider       String?
  status         FleetCashDepositStatus @default(PENDING)
  /// The accountant's decision. rejectReason is required to reject: a refused
  /// deposit with no account of why is a company left guessing.
  confirmedById  String?
  confirmedAt    DateTime?
  rejectReason   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  fleetPartner FleetPartner @relation(fields: [fleetPartnerId], references: [id])

  @@index([tenantId, fleetPartnerId, createdAt])
  @@index([tenantId, status])
}

enum FleetCashDepositStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

/// The four kinds of request a shop raises, as the client described them.
enum SupportTicketType {
  /// Driver late, complaint about the delivery, driver behaviour, order damaged.
  ORDER
  /// Payment, a query about an invoice, a failed payment, a refund.
  WALLET
  /// Software: slow, orders not showing, cannot log in, and suggestions.
  TECHNICAL
  OTHER
}
