  @@index([driverId])
}

model Sim {
  id          String    @id @default(uuid())
  tenantId    String
  phoneNumber String
  carrier     String?
  status      SimStatus @default(ACTIVE)
  driverId    String?
  deviceId    String?
  notes       String?
