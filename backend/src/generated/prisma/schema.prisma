generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations — Neon's pooler cannot run
  // Prisma migrate, which is why `postinstall`'s migrate deploy silently skipped.
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [pg_trgm]
}

