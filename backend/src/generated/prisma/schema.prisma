  updatedAt      DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([date])
}

// 12. PendingDuesLedger
model PendingDuesLedger {
